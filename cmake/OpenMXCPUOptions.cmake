# CPU toolchain selection must precede every enable_language()/project().
set(OPENMX_CPU_COMPILER AUTO CACHE STRING "CPU C/C++ compiler family: AUTO, GCC, CLANG, ICX")
set_property(CACHE OPENMX_CPU_COMPILER PROPERTY STRINGS AUTO GCC CLANG ICX)
set(OPENMX_CPU_MPI AUTO CACHE STRING "CPU MPI implementation: AUTO, OPENMPI, INTEL")
set_property(CACHE OPENMX_CPU_MPI PROPERTY STRINGS AUTO OPENMPI INTEL)
set(OPENMX_CPU_MPI_ROOT "" CACHE PATH "Selected MPI installation prefix (bin/mpicc, bin/mpifort or mpif90)")
set(OPENMX_CPU_LINALG AUTO CACHE STRING "CPU LP64 numerical libraries: AUTO, MKL, OPENBLAS, CUSTOM")
set_property(CACHE OPENMX_CPU_LINALG PROPERTY STRINGS AUTO MKL OPENBLAS CUSTOM)
foreach(option COMPILER MPI LINALG)
  string(TOUPPER "${OPENMX_CPU_${option}}" OPENMX_CPU_${option})
endforeach()
if(NOT OPENMX_CPU_COMPILER MATCHES "^(AUTO|GCC|CLANG|ICX)$")
  message(FATAL_ERROR "OPENMX_CPU_COMPILER must be AUTO, GCC, CLANG or ICX")
endif()
if(NOT OPENMX_CPU_MPI MATCHES "^(AUTO|OPENMPI|INTEL)$")
  message(FATAL_ERROR "OPENMX_CPU_MPI must be AUTO, OPENMPI or INTEL")
endif()
if(NOT OPENMX_CPU_LINALG MATCHES "^(AUTO|MKL|OPENBLAS|CUSTOM)$")
  message(FATAL_ERROR "OPENMX_CPU_LINALG must be AUTO, MKL, OPENBLAS or CUSTOM")
endif()
# MPI/ELPA/ScaLAPACK keep compiler-specific module files and configure caches.
# Never reuse those artifacts for a different toolchain.
set(_cpu_selection "${OPENMX_CPU_COMPILER}|${OPENMX_CPU_MPI}|${OPENMX_CPU_MPI_ROOT}|${OPENMX_CPU_LINALG}")
if(DEFINED OPENMX_CPU_CONFIGURED_SELECTION AND
   NOT OPENMX_CPU_CONFIGURED_SELECTION STREQUAL _cpu_selection)
  message(FATAL_ERROR "CPU compiler/MPI/numerical-library selection changed. Use a new build directory.")
endif()
if(OPENMX_CPU_COMPILER STREQUAL "GCC")
  set(_cpu_c_name gcc)
  set(_cpu_cxx_name g++)
  set(_cpu_compiler_id GNU)
elseif(OPENMX_CPU_COMPILER STREQUAL "CLANG")
  set(_cpu_c_name clang)
  set(_cpu_cxx_name clang++)
  set(_cpu_compiler_id Clang)
elseif(OPENMX_CPU_COMPILER STREQUAL "ICX")
  set(_cpu_c_name icx)
  set(_cpu_cxx_name icpx)
  set(_cpu_compiler_id IntelLLVM)
endif()
if(NOT OPENMX_CPU_COMPILER STREQUAL "AUTO")
  foreach(language C CXX)
    if(NOT CMAKE_${language}_COMPILER)
      string(TOLOWER "${language}" lower)
      find_program(_cpu_${lower}_compiler NAMES "${_cpu_${lower}_name}" REQUIRED NO_CACHE)
      set(CMAKE_${language}_COMPILER "${_cpu_${lower}_compiler}" CACHE FILEPATH "CPU ${language} compiler")
    endif()
  endforeach()
endif()
# C/C++ and Fortran families can be chosen independently. GNU Fortran works
# with all three C/C++ families and the distribution's OpenMPI modules.
# An explicit CMAKE_Fortran_COMPILER (e.g. ifx) always takes precedence.
if(NOT CMAKE_Fortran_COMPILER AND NOT DEFINED ENV{FC})
  find_program(_cpu_fortran NAMES gfortran REQUIRED NO_CACHE)
  set(CMAKE_Fortran_COMPILER "${_cpu_fortran}" CACHE FILEPATH "CPU Fortran compiler")
endif()
enable_language(C CXX Fortran)
set(_cpu_compiler_signature "${CMAKE_C_COMPILER}|${CMAKE_C_COMPILER_VERSION}|${CMAKE_CXX_COMPILER}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_Fortran_COMPILER}|${CMAKE_Fortran_COMPILER_VERSION}")
if(DEFINED OPENMX_CPU_CONFIGURED_COMPILERS AND
   NOT OPENMX_CPU_CONFIGURED_COMPILERS STREQUAL _cpu_compiler_signature)
  message(FATAL_ERROR "CPU compilers changed. Use a new build directory so MPI modules, ELPA and host SIMD use the same toolchain.")
endif()
if(DEFINED _cpu_compiler_id AND
   (NOT CMAKE_C_COMPILER_ID STREQUAL _cpu_compiler_id OR
    NOT CMAKE_CXX_COMPILER_ID STREQUAL _cpu_compiler_id))
  message(FATAL_ERROR "OPENMX_CPU_COMPILER=${OPENMX_CPU_COMPILER} conflicts with CMAKE_C_COMPILER/CMAKE_CXX_COMPILER. Use matching compilers in a new build directory.")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OpenMXMPI.cmake")
openmx_configure_mpi(OPENMX_CPU cpu-mpi)
set(OPENMX_CPU_CONFIGURED_SELECTION "${_cpu_selection}" CACHE INTERNAL "CPU toolchain selection")
set(OPENMX_CPU_CONFIGURED_COMPILERS "${_cpu_compiler_signature}" CACHE INTERNAL "Configured CPU compilers")
message(STATUS "CPU toolchain: ${CMAKE_C_COMPILER_ID} / ${CMAKE_CXX_COMPILER_ID}, Fortran ${CMAKE_Fortran_COMPILER_ID}, MPI ${OPENMX_CPU_MPI_RESOLVED}")
