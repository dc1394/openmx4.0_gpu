# CPU toolchain selection must precede every enable_language()/project().
set(OPENMX_CPU_COMPILER AUTO CACHE STRING "CPU C/C++ compiler family: AUTO, GCC, CLANG, ICX")
set_property(CACHE OPENMX_CPU_COMPILER PROPERTY STRINGS AUTO GCC CLANG ICX)
set(OPENMX_CPU_MPI AUTO CACHE STRING "CPU MPI implementation: AUTO, OPENMPI, INTEL")
set_property(CACHE OPENMX_CPU_MPI PROPERTY STRINGS AUTO OPENMPI INTEL)
set(OPENMX_CPU_MPI_ROOT "" CACHE PATH "Selected MPI installation prefix (bin/mpicc, bin/mpifort or mpif90)")
set(OPENMX_CPU_LINALG AUTO CACHE STRING "CPU LP64 numerical libraries: AUTO, MKL, OPENBLAS, CUSTOM")
set_property(CACHE OPENMX_CPU_LINALG PROPERTY STRINGS AUTO MKL OPENBLAS CUSTOM)
foreach(option COMPILER MPI LINALG)
  string(TOUPPER "${OPENMX_CPU_${option}}" OPENMX_CPU_${option})
endforeach()
if(NOT OPENMX_CPU_COMPILER MATCHES "^(AUTO|GCC|CLANG|ICX)$")
  message(FATAL_ERROR "OPENMX_CPU_COMPILER must be AUTO, GCC, CLANG or ICX")
endif()
if(NOT OPENMX_CPU_MPI MATCHES "^(AUTO|OPENMPI|INTEL)$")
  message(FATAL_ERROR "OPENMX_CPU_MPI must be AUTO, OPENMPI or INTEL")
endif()
if(NOT OPENMX_CPU_LINALG MATCHES "^(AUTO|MKL|OPENBLAS|CUSTOM)$")
  message(FATAL_ERROR "OPENMX_CPU_LINALG must be AUTO, MKL, OPENBLAS or CUSTOM")
endif()
# MPI/ELPA/ScaLAPACK keep compiler-specific module files and configure caches.
# Never reuse those artifacts for a different toolchain.
set(_cpu_selection "${OPENMX_CPU_COMPILER}|${OPENMX_CPU_MPI}|${OPENMX_CPU_MPI_ROOT}|${OPENMX_CPU_LINALG}")
if(DEFINED OPENMX_CPU_CONFIGURED_SELECTION AND
   NOT OPENMX_CPU_CONFIGURED_SELECTION STREQUAL _cpu_selection)
  message(FATAL_ERROR "CPU compiler/MPI/numerical-library selection changed. Use a new build directory.")
endif()
if(OPENMX_CPU_COMPILER STREQUAL "GCC")
  set(_cpu_c_name gcc)
  set(_cpu_cxx_name g++)
  set(_cpu_compiler_id GNU)
elseif(OPENMX_CPU_COMPILER STREQUAL "CLANG")
  set(_cpu_c_name clang)
  set(_cpu_cxx_name clang++)
  set(_cpu_compiler_id Clang)
elseif(OPENMX_CPU_COMPILER STREQUAL "ICX")
  set(_cpu_c_name icx)
  set(_cpu_cxx_name icpx)
  set(_cpu_compiler_id IntelLLVM)
endif()
if(NOT OPENMX_CPU_COMPILER STREQUAL "AUTO")
  foreach(language C CXX)
    if(NOT CMAKE_${language}_COMPILER)
      string(TOLOWER "${language}" lower)
      find_program(_cpu_${lower}_compiler NAMES "${_cpu_${lower}_name}" REQUIRED NO_CACHE)
      set(CMAKE_${language}_COMPILER "${_cpu_${lower}_compiler}" CACHE FILEPATH "CPU ${language} compiler")
    endif()
  endforeach()
endif()
# C/C++ and Fortran families can be chosen independently. GNU Fortran works
# with all three C/C++ families and the distribution's OpenMPI modules.
# An explicit CMAKE_Fortran_COMPILER (e.g. ifx) always takes precedence.
if(NOT CMAKE_Fortran_COMPILER AND NOT DEFINED ENV{FC})
  find_program(_cpu_fortran NAMES gfortran REQUIRED NO_CACHE)
  set(CMAKE_Fortran_COMPILER "${_cpu_fortran}" CACHE FILEPATH "CPU Fortran compiler")
endif()
enable_language(C CXX Fortran)
set(_cpu_compiler_signature "${CMAKE_C_COMPILER}|${CMAKE_C_COMPILER_VERSION}|${CMAKE_CXX_COMPILER}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_Fortran_COMPILER}|${CMAKE_Fortran_COMPILER_VERSION}")
if(DEFINED OPENMX_CPU_CONFIGURED_COMPILERS AND
   NOT OPENMX_CPU_CONFIGURED_COMPILERS STREQUAL _cpu_compiler_signature)
  message(FATAL_ERROR "CPU compilers changed. Use a new build directory so MPI modules, ELPA and host SIMD use the same toolchain.")
endif()
if(DEFINED _cpu_compiler_id AND
   (NOT CMAKE_C_COMPILER_ID STREQUAL _cpu_compiler_id OR
    NOT CMAKE_CXX_COMPILER_ID STREQUAL _cpu_compiler_id))
  message(FATAL_ERROR "OPENMX_CPU_COMPILER=${OPENMX_CPU_COMPILER} conflicts with CMAKE_C_COMPILER/CMAKE_CXX_COMPILER. Use matching compilers in a new build directory.")
endif()

# Choose one installation, then use private wrappers for both FindMPI and the
# external ELPA/ScaLAPACK builds. Wrapper defaults must not silently replace
# the selected C/C++/Fortran compilers (in particular Intel MPI defaults).
set(_cpu_mpi_hints)
if(OPENMX_CPU_MPI_ROOT)
  list(APPEND _cpu_mpi_hints "${OPENMX_CPU_MPI_ROOT}")
elseif(OPENMX_CPU_MPI STREQUAL "INTEL")
  list(APPEND _cpu_mpi_hints "$ENV{I_MPI_ROOT}")
elseif(OPENMX_CPU_MPI STREQUAL "OPENMPI")
  list(APPEND _cpu_mpi_hints "$ENV{OPENMPI_ROOT}")
endif()
if(DEFINED OPENMX_CPU_RAW_MPI_C)
  set(_cpu_mpicc "${OPENMX_CPU_RAW_MPI_C}")
elseif(MPI_C_COMPILER AND OPENMX_CPU_MPI STREQUAL "AUTO" AND NOT OPENMX_CPU_MPI_ROOT)
  set(_cpu_mpicc "${MPI_C_COMPILER}")
else()
  set(_cpu_mpicc_names mpicc)
  if(OPENMX_CPU_MPI STREQUAL "INTEL")
    set(_cpu_mpicc_names mpiicx mpicc)
  endif()
  if(OPENMX_CPU_MPI_ROOT)
    find_program(_cpu_mpicc NAMES ${_cpu_mpicc_names} PATHS ${_cpu_mpi_hints}
      PATH_SUFFIXES bin bin64 NO_DEFAULT_PATH REQUIRED NO_CACHE)
  else()
    find_program(_cpu_mpicc NAMES ${_cpu_mpicc_names} HINTS ${_cpu_mpi_hints}
      PATH_SUFFIXES bin bin64 REQUIRED NO_CACHE)
  endif()
endif()
get_filename_component(_cpu_mpi_bin "${_cpu_mpicc}" DIRECTORY)
get_filename_component(_cpu_mpi_prefix "${_cpu_mpi_bin}/.." ABSOLUTE)
set(_cpu_mpi_environment)
if(EXISTS "${_cpu_mpi_prefix}/include/mpi.h")
  file(STRINGS "${_cpu_mpi_prefix}/include/mpi.h" _cpu_intel_header REGEX "^#[ \t]*define[ \t]+I_MPI_VERSION")
  if(_cpu_intel_header)
    string(REPLACE "'" "'\"'\"'" _cpu_quoted_prefix "${_cpu_mpi_prefix}")
    set(_cpu_mpi_environment "I_MPI_ROOT='${_cpu_quoted_prefix}' ")
  endif()
endif()
foreach(language C CXX Fortran)
  if(language STREQUAL "C")
    set(_cpu_wrapper "${_cpu_mpicc}")
  elseif(DEFINED OPENMX_CPU_RAW_MPI_${language})
    set(_cpu_wrapper "${OPENMX_CPU_RAW_MPI_${language}}")
  elseif(MPI_${language}_COMPILER AND OPENMX_CPU_MPI STREQUAL "AUTO" AND NOT OPENMX_CPU_MPI_ROOT)
    set(_cpu_wrapper "${MPI_${language}_COMPILER}")
  else()
    unset(_cpu_wrapper)
    if(language STREQUAL "CXX")
      set(_cpu_names mpicxx mpic++ mpiicpx)
    else()
      set(_cpu_names mpifort mpif90 mpifc mpiifx)
    endif()
    find_program(_cpu_wrapper NAMES ${_cpu_names} PATHS "${_cpu_mpi_bin}"
      NO_DEFAULT_PATH REQUIRED NO_CACHE)
  endif()
  set(OPENMX_CPU_RAW_MPI_${language} "${_cpu_wrapper}" CACHE INTERNAL "Original CPU MPI wrapper")
  # POSIX single-quote escaping also handles spaces/apostrophes in prefixes.
  foreach(value _cpu_wrapper CMAKE_${language}_COMPILER)
    string(REPLACE "'" "'\"'\"'" _quoted_${value} "${${value}}")
  endforeach()
  set(_cpu_proxy "${CMAKE_BINARY_DIR}/cpu-mpi/${language}")
  set(_cpu_driver "${_quoted_CMAKE_${language}_COMPILER}")
  if(language STREQUAL "C")
    set(_cpu_override "OMPI_CC='${_cpu_driver}' MPICH_CC='${_cpu_driver}' I_MPI_CC='${_cpu_driver}'")
  elseif(language STREQUAL "CXX")
    set(_cpu_override "OMPI_CXX='${_cpu_driver}' MPICH_CXX='${_cpu_driver}' I_MPI_CXX='${_cpu_driver}'")
  else()
    set(_cpu_override "OMPI_FC='${_cpu_driver}' MPICH_FC='${_cpu_driver}' I_MPI_F90='${_cpu_driver}' I_MPI_FC='${_cpu_driver}'")
  endif()
  file(WRITE "${_cpu_proxy}" "#!/bin/sh\nexec env ${_cpu_mpi_environment}${_cpu_override} '${_quoted__cpu_wrapper}' \"$@\"\n")
  file(CHMOD "${_cpu_proxy}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  set(MPI_${language}_COMPILER "${_cpu_proxy}" CACHE FILEPATH "MPI wrapper using the selected CPU compiler" FORCE)
endforeach()
if(NOT MPIEXEC_EXECUTABLE)
  find_program(MPIEXEC_EXECUTABLE NAMES mpiexec mpirun PATHS "${_cpu_mpi_bin}" NO_DEFAULT_PATH REQUIRED)
endif()
set(MPI_CXX_SKIP_MPICXX ON)
find_package(MPI REQUIRED COMPONENTS C CXX Fortran)
set(_cpu_mpi_libraries)
foreach(language C CXX Fortran)
  foreach(library IN LISTS MPI_${language}_LIBRARIES)
    get_filename_component(name "${library}" NAME)
    if(name MATCHES "^libmpi\\.(so(\\..*)?|a|dylib)$")
      get_filename_component(real_library "${library}" REALPATH)
      list(APPEND _cpu_mpi_libraries "${real_library}")
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES _cpu_mpi_libraries)
list(LENGTH _cpu_mpi_libraries _cpu_mpi_library_count)
if(_cpu_mpi_library_count GREATER 1)
  message(FATAL_ERROR "C, C++ and Fortran wrappers refer to different MPI libraries: ${_cpu_mpi_libraries}. Select one OPENMX_CPU_MPI_ROOT in a new build directory.")
endif()
# Check headers with the actual include/link settings, not wrapper filenames.
include(CheckCSourceCompiles)
set(CMAKE_REQUIRED_LIBRARIES MPI::MPI_C)
check_c_source_compiles("#include <mpi.h>\n#ifndef OPEN_MPI\n#error not OpenMPI\n#endif\nint main(void){return 0;}" OPENMX_CPU_MPI_IS_OPENMPI)
check_c_source_compiles("#include <mpi.h>\n#ifndef I_MPI_VERSION\n#error not Intel MPI\n#endif\nint main(void){return 0;}" OPENMX_CPU_MPI_IS_INTEL)
unset(CMAKE_REQUIRED_LIBRARIES)
if(OPENMX_CPU_MPI_IS_OPENMPI)
  set(OPENMX_CPU_MPI_RESOLVED OPENMPI)
elseif(OPENMX_CPU_MPI_IS_INTEL)
  set(OPENMX_CPU_MPI_RESOLVED INTEL)
else()
  message(FATAL_ERROR "CPU builds support OpenMPI and Intel MPI. Set OPENMX_CPU_MPI and OPENMX_CPU_MPI_ROOT to a supported installation.")
endif()
if(NOT OPENMX_CPU_MPI STREQUAL "AUTO" AND NOT OPENMX_CPU_MPI STREQUAL OPENMX_CPU_MPI_RESOLVED)
  message(FATAL_ERROR "Requested ${OPENMX_CPU_MPI}, but found ${OPENMX_CPU_MPI_RESOLVED}. Set OPENMX_CPU_MPI_ROOT to the requested MPI installation.")
endif()
set(OPENMX_CPU_CONFIGURED_SELECTION "${_cpu_selection}" CACHE INTERNAL "CPU toolchain selection")
set(OPENMX_CPU_CONFIGURED_COMPILERS "${_cpu_compiler_signature}" CACHE INTERNAL "Configured CPU compilers")
message(STATUS "CPU toolchain: ${CMAKE_C_COMPILER_ID} / ${CMAKE_CXX_COMPILER_ID}, Fortran ${CMAKE_Fortran_COMPILER_ID}, MPI ${OPENMX_CPU_MPI_RESOLVED}")
