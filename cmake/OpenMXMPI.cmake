# Shared MPI discovery for CPU and HIP applications. The caller enables the
# selected raw compilers first; all dependency builds use these same proxies.
macro(openmx_configure_mpi _mpi_prefix _mpi_directory)
  # Choose one installation, then use private wrappers for both FindMPI and the
  # external ELPA/ScaLAPACK builds. Wrapper defaults must not silently replace
  # the selected C/C++/Fortran compilers (in particular Intel MPI defaults).
  set(_host_mpi_hints)
  if(${_mpi_prefix}_MPI_ROOT)
    list(APPEND _host_mpi_hints "${${_mpi_prefix}_MPI_ROOT}")
  elseif(${_mpi_prefix}_MPI STREQUAL "INTEL")
    list(APPEND _host_mpi_hints "$ENV{I_MPI_ROOT}")
  elseif(${_mpi_prefix}_MPI STREQUAL "OPENMPI")
    list(APPEND _host_mpi_hints "$ENV{OPENMPI_ROOT}")
  endif()
  if(DEFINED ${_mpi_prefix}_RAW_MPI_C)
    set(_host_mpi_mpicc "${${_mpi_prefix}_RAW_MPI_C}")
  elseif(MPI_C_COMPILER AND ${_mpi_prefix}_MPI STREQUAL "AUTO" AND NOT ${_mpi_prefix}_MPI_ROOT)
    set(_host_mpi_mpicc "${MPI_C_COMPILER}")
  else()
    set(_host_mpi_mpicc_names mpicc)
    if(${_mpi_prefix}_MPI STREQUAL "INTEL")
      set(_host_mpi_mpicc_names mpiicx mpicc)
    endif()
    if(${_mpi_prefix}_MPI_ROOT)
      find_program(_host_mpi_mpicc NAMES ${_host_mpi_mpicc_names} PATHS ${_host_mpi_hints}
        PATH_SUFFIXES bin bin64 NO_DEFAULT_PATH REQUIRED NO_CACHE)
    else()
      find_program(_host_mpi_mpicc NAMES ${_host_mpi_mpicc_names} HINTS ${_host_mpi_hints}
        PATH_SUFFIXES bin bin64 REQUIRED NO_CACHE)
    endif()
  endif()
  get_filename_component(_host_mpi_bin "${_host_mpi_mpicc}" DIRECTORY)
  get_filename_component(_host_mpi_prefix "${_host_mpi_bin}/.." ABSOLUTE)
  set(_host_mpi_environment)
  if(EXISTS "${_host_mpi_prefix}/include/mpi.h")
    file(STRINGS "${_host_mpi_prefix}/include/mpi.h" _host_mpi_intel_header REGEX "^#[ \t]*define[ \t]+I_MPI_VERSION")
    if(_host_mpi_intel_header)
      string(REPLACE "'" "'\"'\"'" _host_mpi_quoted_prefix "${_host_mpi_prefix}")
      set(_host_mpi_environment "I_MPI_ROOT='${_host_mpi_quoted_prefix}' ")
    endif()
  endif()
  foreach(language C CXX Fortran)
    if(language STREQUAL "C")
      set(_host_mpi_wrapper "${_host_mpi_mpicc}")
    elseif(DEFINED ${_mpi_prefix}_RAW_MPI_${language})
      set(_host_mpi_wrapper "${${_mpi_prefix}_RAW_MPI_${language}}")
    elseif(MPI_${language}_COMPILER AND ${_mpi_prefix}_MPI STREQUAL "AUTO" AND NOT ${_mpi_prefix}_MPI_ROOT)
      set(_host_mpi_wrapper "${MPI_${language}_COMPILER}")
    else()
      unset(_host_mpi_wrapper)
      if(language STREQUAL "CXX")
        set(_host_mpi_names mpicxx mpic++ mpiicpx)
      else()
        set(_host_mpi_names mpifort mpif90 mpifc mpiifx)
      endif()
      find_program(_host_mpi_wrapper NAMES ${_host_mpi_names} PATHS "${_host_mpi_bin}"
        NO_DEFAULT_PATH REQUIRED NO_CACHE)
    endif()
    set(${_mpi_prefix}_RAW_MPI_${language} "${_host_mpi_wrapper}" CACHE INTERNAL "Original host MPI wrapper")
    # POSIX single-quote escaping also handles spaces/apostrophes in prefixes.
    foreach(value _host_mpi_wrapper CMAKE_${language}_COMPILER)
      string(REPLACE "'" "'\"'\"'" _quoted_${value} "${${value}}")
    endforeach()
    set(_host_mpi_proxy "${CMAKE_BINARY_DIR}/${_mpi_directory}/${language}")
    set(_host_mpi_driver "${_quoted_CMAKE_${language}_COMPILER}")
    if(language STREQUAL "C")
      set(_host_mpi_override "OMPI_CC='${_host_mpi_driver}' MPICH_CC='${_host_mpi_driver}' I_MPI_CC='${_host_mpi_driver}'")
    elseif(language STREQUAL "CXX")
      set(_host_mpi_override "OMPI_CXX='${_host_mpi_driver}' MPICH_CXX='${_host_mpi_driver}' I_MPI_CXX='${_host_mpi_driver}'")
    else()
      set(_host_mpi_override "OMPI_FC='${_host_mpi_driver}' MPICH_FC='${_host_mpi_driver}' I_MPI_F90='${_host_mpi_driver}' I_MPI_FC='${_host_mpi_driver}'")
    endif()
    file(WRITE "${_host_mpi_proxy}" "#!/bin/sh\nexec env ${_host_mpi_environment}${_host_mpi_override} '${_quoted__host_mpi_wrapper}' \"$@\"\n")
    file(CHMOD "${_host_mpi_proxy}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    set(MPI_${language}_COMPILER "${_host_mpi_proxy}" CACHE FILEPATH "MPI wrapper using the selected host compiler" FORCE)
  endforeach()
  if(NOT MPIEXEC_EXECUTABLE)
    find_program(MPIEXEC_EXECUTABLE NAMES mpiexec mpirun PATHS "${_host_mpi_bin}" NO_DEFAULT_PATH REQUIRED)
  endif()
  set(MPI_CXX_SKIP_MPICXX ON)
  find_package(MPI REQUIRED COMPONENTS C CXX Fortran)
  set(_host_mpi_libraries)
  foreach(language C CXX Fortran)
    foreach(library IN LISTS MPI_${language}_LIBRARIES)
      get_filename_component(name "${library}" NAME)
      if(name MATCHES "^libmpi\\.(so(\\..*)?|a|dylib)$")
        get_filename_component(real_library "${library}" REALPATH)
        list(APPEND _host_mpi_libraries "${real_library}")
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES _host_mpi_libraries)
  list(LENGTH _host_mpi_libraries _host_mpi_library_count)
  if(_host_mpi_library_count GREATER 1)
    message(FATAL_ERROR "C, C++ and Fortran wrappers refer to different MPI libraries: ${_host_mpi_libraries}. Select one ${_mpi_prefix}_MPI_ROOT in a new build directory.")
  endif()
  # Check headers with the actual include/link settings, not wrapper filenames.
  include(CheckCSourceCompiles)
  set(CMAKE_REQUIRED_LIBRARIES MPI::MPI_C)
  check_c_source_compiles("#include <mpi.h>\n#ifndef OPEN_MPI\n#error not OpenMPI\n#endif\nint main(void){return 0;}" ${_mpi_prefix}_MPI_IS_OPENMPI)
  check_c_source_compiles("#include <mpi.h>\n#ifndef I_MPI_VERSION\n#error not Intel MPI\n#endif\nint main(void){return 0;}" ${_mpi_prefix}_MPI_IS_INTEL)
  unset(CMAKE_REQUIRED_LIBRARIES)
  if(${_mpi_prefix}_MPI_IS_OPENMPI)
    set(${_mpi_prefix}_MPI_RESOLVED OPENMPI)
  elseif(${_mpi_prefix}_MPI_IS_INTEL)
    set(${_mpi_prefix}_MPI_RESOLVED INTEL)
  else()
    message(FATAL_ERROR "Host builds support OpenMPI and Intel MPI. Set ${_mpi_prefix}_MPI and ${_mpi_prefix}_MPI_ROOT to a supported installation.")
  endif()
  if(NOT ${_mpi_prefix}_MPI STREQUAL "AUTO" AND NOT ${_mpi_prefix}_MPI STREQUAL ${_mpi_prefix}_MPI_RESOLVED)
    message(FATAL_ERROR "Requested ${${_mpi_prefix}_MPI}, but found ${${_mpi_prefix}_MPI_RESOLVED}. Set ${_mpi_prefix}_MPI_ROOT to the requested MPI installation.")
  endif()
endmacro()
