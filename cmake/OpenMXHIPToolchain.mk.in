# Generated by CMake. Change OPENMX_HIP_* in a new build directory.
ROCM := @OPENMX_HIP_ROCM_ROOT@
export HIP_PATH := $(ROCM)
export ROCM_PATH := $(ROCM)
export HIP_CLANG_PATH := $(ROCM)/llvm/bin
CLANG := @CMAKE_C_COMPILER@
CPPLANG := @CMAKE_CXX_COMPILER@
FLANG := @CMAKE_Fortran_COMPILER@
MPI_HOME := @_hip_mpi_prefix@
MPICC := @MPI_C_COMPILER@
MPICXX := @MPI_CXX_COMPILER@
MPIF90 := @MPI_Fortran_COMPILER@
MPI_CFLAGS := @_hip_C_flags@
MPI_CXXFLAGS := @_hip_CXX_flags@
MPI_FCFLAGS := @_hip_Fortran_flags@
HOST_INCLUDES := -I@OPENMX_HIP_FFTW_INCLUDE_DIR@
MATH_GROUP := @_hip_math_link@
HOST_LAPACK_LIBS := @_hip_lapack_link@
FFTW_LIBS := @OPENMX_HIP_FFTW_LIBRARY@ -lm
MPI_FORTRAN_LIBS := @_hip_mpi_link@
FLANG_RTL_LIBS := @_hip_library_dirs@ @_hip_fortran_link@
RPATHS := @_hip_rpaths@
GPUSOLVER2_HOST_CC := @CMAKE_C_COMPILER@
GPUSOLVER2_HOST_CXX := @CMAKE_CXX_COMPILER@
GPUSOLVER2_MPI_BIN := @_hip_mpi_bin@
GPUSOLVER2_HOST_CONFIG := @_hip_stack_config@
GPUSOLVER2_CMAKE := @CMAKE_COMMAND@
