# HIP uses ROCm Clang for OpenMP target offload, independently of the MPI
# vendor and host numerical libraries. Select it before Core enables C++.
set(OPENMX_HIP_MPI OPENMPI CACHE STRING "HIP host MPI: OPENMPI or INTEL")
set_property(CACHE OPENMX_HIP_MPI PROPERTY STRINGS OPENMPI INTEL)
set(OPENMX_HIP_LINALG AOCL CACHE STRING "HIP host LP64 libraries: AOCL, MKL or OPENBLAS")
set_property(CACHE OPENMX_HIP_LINALG PROPERTY STRINGS AOCL MKL OPENBLAS)
foreach(option MPI LINALG)
  string(TOUPPER "${OPENMX_HIP_${option}}" OPENMX_HIP_${option})
endforeach()
if(NOT OPENMX_HIP_MPI MATCHES "^(OPENMPI|INTEL)$")
  message(FATAL_ERROR "OPENMX_HIP_MPI must be OPENMPI or INTEL")
endif()
if(NOT OPENMX_HIP_LINALG MATCHES "^(AOCL|MKL|OPENBLAS)$")
  message(FATAL_ERROR "OPENMX_HIP_LINALG must be AOCL, MKL or OPENBLAS")
endif()
# These flags are generated from FindMPI and the LP64 provider. Reject
# native overrides that would give the application and ELPA different ABIs.
foreach(assignment IN LISTS OPENMX_MAKE_OPTIONS)
  if(assignment MATCHES "^(CLANG|CPPLANG|HIPCC|FLANG|ROCM_LLVM|ROCM_LIB|ROCM_LLVM_LIB|MPICC|MPICXX|MPIF90|MPI_LIBDIR|MPI_CFLAGS|MPI_CXXFLAGS|MPI_FCFLAGS|MPI_FORTRAN_LIBS|AOCL_INC|AOCL_LIB|AOCL_THREADING|SCALAPACK_LIBS|LAPACK_LIBS|BLAS_LIBS|AOCL_UTILS_LIBS|FFTW_LIBS|HOST_INCLUDES|HOST_LAPACK_LIBS|MATH_GROUP|FLANG_RTL_LIBS|RPATHS|LIB|CC|CC2|CC3|CXX|FC|GPUSOLVER2_(HOST_CC|HOST_CXX|HOST_CONFIG|MPI_BIN|MPI_LIBDIR|ROCM|AOCL_LIB|AOCL_INC|AOCL_THREADING|AOCC_LIB|SCALAPACK_SO))=")
    message(FATAL_ERROR "${CMAKE_MATCH_1} is managed by the HIP CMake toolchain. Use OPENMX_HIP_* or CMAKE_<LANG>_COMPILER in a new build directory.")
  endif()
endforeach()
# Preserve old CMake invocations using OPENMX_MAKE_OPTIONS for installation
# prefixes. A contradictory override must not split Core and native builds.
foreach(pair ROCM:ROCM_ROOT MPI_HOME:MPI_ROOT AOCL_HOME:AOCL_ROOT AOCC_LIB:AOCC_LIB)
  string(REPLACE ":" ";" parts "${pair}")
  list(GET parts 0 native)
  list(GET parts 1 option)
  foreach(assignment IN LISTS OPENMX_MAKE_OPTIONS)
    if(assignment MATCHES "^${native}=(.*)$")
      if(DEFINED OPENMX_HIP_${option} AND NOT OPENMX_HIP_${option} STREQUAL CMAKE_MATCH_1)
        message(FATAL_ERROR "${native} in OPENMX_MAKE_OPTIONS conflicts with OPENMX_HIP_${option}")
      endif()
      set(OPENMX_HIP_${option} "${CMAKE_MATCH_1}" CACHE PATH "HIP ${option} installation")
    endif()
  endforeach()
endforeach()
set(OPENMX_HIP_ROCM_ROOT "/opt/rocm" CACHE PATH "ROCm SDK prefix (including development packages)")
set(OPENMX_HIP_MPI_ROOT "" CACHE PATH "MPI prefix containing bin/mpicc and bin/mpifort or mpif90")
set(OPENMX_HIP_AOCL_ROOT "$ENV{AOCL_ROOT}" CACHE PATH "AOCL LP64 installation prefix")
set(OPENMX_HIP_AOCC_LIB "" CACHE PATH "AOCC runtime directory, when required by AOCL")
set(_hip_selection "${OPENMX_HIP_MPI}|${OPENMX_HIP_MPI_ROOT}|${OPENMX_HIP_LINALG}|${OPENMX_HIP_ROCM_ROOT}|${OPENMX_HIP_AOCC_LIB}")
if(DEFINED OPENMX_HIP_CONFIGURED_SELECTION AND NOT OPENMX_HIP_CONFIGURED_SELECTION STREQUAL _hip_selection)
  message(FATAL_ERROR "HIP compiler/MPI/numerical-library selection changed. Use a new build directory.")
endif()
foreach(pair C:clang CXX:clang++ Fortran:flang)
  string(REPLACE ":" ";" parts "${pair}")
  list(GET parts 0 language)
  list(GET parts 1 driver)
  if(NOT CMAKE_${language}_COMPILER)
    find_program(_hip_${language}_compiler NAMES ${driver}
      PATHS "${OPENMX_HIP_ROCM_ROOT}/llvm/bin" NO_DEFAULT_PATH REQUIRED NO_CACHE)
    set(CMAKE_${language}_COMPILER "${_hip_${language}_compiler}" CACHE FILEPATH "HIP host ${language} compiler")
  endif()
endforeach()
if(NOT CMAKE_HIP_COMPILER)
  set(CMAKE_HIP_COMPILER "${CMAKE_CXX_COMPILER}" CACHE FILEPATH "ROCm HIP compiler")
endif()
if(NOT CMAKE_HIP_COMPILER_ROCM_ROOT)
  set(CMAKE_HIP_COMPILER_ROCM_ROOT "${OPENMX_HIP_ROCM_ROOT}" CACHE PATH "ROCm SDK for the HIP compiler")
endif()
list(PREPEND CMAKE_PREFIX_PATH "${OPENMX_HIP_ROCM_ROOT}")
enable_language(C CXX Fortran)
if(NOT CMAKE_C_COMPILER_ID STREQUAL "Clang" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
  message(FATAL_ERROR "The HIP application requires ROCm Clang for C/C++ OpenMP target offload")
endif()
set(_hip_compilers "${CMAKE_C_COMPILER}|${CMAKE_C_COMPILER_VERSION}|${CMAKE_CXX_COMPILER}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_Fortran_COMPILER}|${CMAKE_Fortran_COMPILER_VERSION}")
if(DEFINED OPENMX_HIP_CONFIGURED_COMPILERS AND NOT OPENMX_HIP_CONFIGURED_COMPILERS STREQUAL _hip_compilers)
  message(FATAL_ERROR "HIP host compilers changed. Use a new build directory.")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OpenMXMPI.cmake")
openmx_configure_mpi(OPENMX_HIP hip-mpi)
set(OPENMX_HIP_CONFIGURED_SELECTION "${_hip_selection}" CACHE INTERNAL "HIP toolchain selection")
set(OPENMX_HIP_CONFIGURED_COMPILERS "${_hip_compilers}" CACHE INTERNAL "HIP host compilers")
message(STATUS "HIP host toolchain: ${CMAKE_C_COMPILER_ID}, Fortran ${CMAKE_Fortran_COMPILER_ID}, MPI ${OPENMX_HIP_MPI_RESOLVED}")
