openmx_hip_library_flags(_hip_math_link NATIVE ${_hip_complete_math})
openmx_hip_library_flags(_hip_lapack_link NATIVE ${OPENMX_HIP_LAPACK_LIBRARIES})
openmx_hip_library_flags(_hip_elpa_math AUTOCONF ${_hip_complete_math})

