# Flags in Autoconf LIBS must remain in order (absolute static archives can
# be hoisted by libtool). Use -L/-l for ELPA, absolute paths for native make.
function(openmx_hip_library_flags output mode)
  set(flags)
  foreach(library IN LISTS ARGN)
    if(IS_ABSOLUTE "${library}" AND mode STREQUAL "AUTOCONF")
      get_filename_component(directory "${library}" DIRECTORY)
      get_filename_component(filename "${library}" NAME)
      # Exact filenames also cover versioned AOCC runtime DSOs without a
      # development symlink, and preserve static-versus-shared selection.
      list(APPEND flags "-L${directory}" "-l:${filename}")
    elseif(IS_ABSOLUTE "${library}" OR library MATCHES "^-")
      list(APPEND flags "${library}")
    else()
      list(APPEND flags "-l${library}")
    endif()
  endforeach()
  string(JOIN " " flags ${flags})
  set(${output} "${flags}" PARENT_SCOPE)
endfunction()

set(_hip_mpi_flags)
foreach(language C CXX Fortran)
  set(_hip_${language}_flags ${MPI_${language}_COMPILE_OPTIONS})
  foreach(directory IN LISTS MPI_${language}_INCLUDE_DIRS)
    list(APPEND _hip_${language}_flags "-I${directory}")
  endforeach()
  foreach(definition IN LISTS MPI_${language}_COMPILE_DEFINITIONS)
    list(APPEND _hip_${language}_flags "-D${definition}")
  endforeach()
  string(JOIN " " _hip_${language}_flags ${_hip_${language}_flags})
  list(APPEND _hip_mpi_flags ${MPI_${language}_LINK_FLAGS} ${MPI_${language}_LIBRARIES})
endforeach()
list(REMOVE_DUPLICATES _hip_mpi_flags)
openmx_hip_library_flags(_hip_mpi_link NATIVE ${_hip_mpi_flags})
openmx_hip_library_flags(_hip_fortran_link NATIVE ${CMAKE_Fortran_IMPLICIT_LINK_LIBRARIES})

# Put ROCm's OpenMP ahead of the AOCC/Intel runtimes, including transitive
# dependencies. The application must work from a clean login shell.
# Both ROCm layouts must precede system paths: on some clusters the login
# node has llvm/lib while compute nodes expose only lib/llvm/lib. Loading
# system libomp with ROCm libomptarget can crash during device initialization.
set(_hip_runtime_dirs "${OPENMX_HIP_ROCM_ROOT}/llvm/lib"
                      "${OPENMX_HIP_ROCM_ROOT}/lib/llvm/lib"
                      "${OPENMX_HIP_ROCM_ROOT}/lib")
# MPI must precede host BLAS directories: a system OpenBLAS prefix may also
# contain a different OpenMPI with the same SONAME as the selected installation.
foreach(library IN LISTS MPI_C_LIBRARIES MPI_Fortran_LIBRARIES OPENMX_HIP_LINALG_LIBRARIES OPENMX_HIP_FFTW_LIBRARY)
  if(IS_ABSOLUTE "${library}")
    get_filename_component(directory "${library}" DIRECTORY)
    list(APPEND _hip_runtime_dirs "${directory}")
  endif()
endforeach()
list(APPEND _hip_runtime_dirs ${CMAKE_Fortran_IMPLICIT_LINK_DIRECTORIES})
if(OPENMX_HIP_LINALG STREQUAL "AOCL" AND OPENMX_HIP_AOCC_LIB)
  list(APPEND _hip_runtime_dirs "${OPENMX_HIP_AOCC_LIB}")
endif()
list(REMOVE_DUPLICATES _hip_runtime_dirs)
# Some AOCL binary packages embed a build-machine RUNPATH in ScaLAPACK.
# Such a DSO ignores the application's inherited RPATH for its own children.
# Link those children explicitly, also validating its MPI SONAME. Never load
# an OpenMPI ScaLAPACK into an Intel MPI process (or vice versa).
set(OPENMX_HIP_RUNTIME_LIBRARIES)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  find_program(_hip_readelf NAMES llvm-readelf readelf REQUIRED)
  set(_hip_mpi_sonames)
  foreach(library IN LISTS MPI_C_LIBRARIES MPI_Fortran_LIBRARIES)
    execute_process(COMMAND "${_hip_readelf}" -d "${library}" OUTPUT_VARIABLE dynamic ERROR_QUIET)
    if(dynamic MATCHES "[(]SONAME[)][^\n]*\\[([^]]+)\\]")
      list(APPEND _hip_mpi_sonames "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  foreach(library IN LISTS OPENMX_HIP_LINALG_LIBRARIES)
    if(NOT EXISTS "${library}" OR library MATCHES "\\.a$")
      continue()
    endif()
    execute_process(COMMAND "${_hip_readelf}" -d "${library}" OUTPUT_VARIABLE dynamic ERROR_QUIET)
    string(REGEX MATCHALL "[(]NEEDED[)][^\n]*\\[[^]]+\\]" needed "${dynamic}")
    foreach(entry IN LISTS needed)
      string(REGEX REPLACE ".*\\[([^]]+)\\].*" "\\1" name "${entry}")
      if(name MATCHES "^libmpi\\.so" AND NOT name IN_LIST _hip_mpi_sonames)
        message(FATAL_ERROR "${library} requires ${name}, incompatible with the selected ${OPENMX_HIP_MPI_RESOLVED}. Supply OPENMX_HIP_SCALAPACK_LIBRARY built for this MPI.")
      endif()
      if(NOT OPENMX_HIP_LINALG STREQUAL "AOCL")
        continue()
      endif()
      unset(dependency)
      find_library(dependency NAMES "${name}" PATHS ${_hip_runtime_dirs} NO_DEFAULT_PATH NO_CACHE)
      if(NOT dependency)
        message(FATAL_ERROR "Cannot resolve ${name} required by ${library}. Set OPENMX_HIP_AOCC_LIB if using AOCC-built AOCL.")
      endif()
      list(APPEND OPENMX_HIP_RUNTIME_LIBRARIES "${dependency}")
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES OPENMX_HIP_RUNTIME_LIBRARIES)
endif()
set(_hip_complete_math ${OPENMX_HIP_LINALG_LIBRARIES})
if(OPENMX_HIP_RUNTIME_LIBRARIES)
  list(APPEND _hip_complete_math -Wl,--no-as-needed ${OPENMX_HIP_RUNTIME_LIBRARIES} -Wl,--as-needed)
