include_guard(GLOBAL)

# One CUDA architecture is shared by NVHPC, nvcc, ELPA/COSMA and the core.
# Kokkos currently builds for one device architecture per configuration.
function(openmx_resolve_cuda_architecture)
  set(_requested "${OPENMX_GPU_ARCH}")
  string(TOLOWER "${_requested}" _requested)
  if(_requested STREQUAL "" OR _requested STREQUAL "auto")
    # Always query in automatic mode, including on reconfiguration. A cached
    # CUDA target must not hide an unavailable GPU or a missing nvidia-smi.
    set(_hint "Specify -DOPENMX_GPU_ARCH=sm_80 (A100), sm_90 (H100), or sm_120 (RTX 5080) for the target GPU.")
    find_program(_openmx_nvidia_smi NAMES nvidia-smi NO_CACHE)
    if(NOT _openmx_nvidia_smi)
      message(FATAL_ERROR "Cannot auto-detect the CUDA architecture: nvidia-smi was not found. ${_hint}")
    endif()
    execute_process(
      COMMAND "${_openmx_nvidia_smi}" --query-gpu=compute_cap --format=csv,noheader
      RESULT_VARIABLE _smi_result OUTPUT_VARIABLE _smi_output ERROR_VARIABLE _smi_error
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE TIMEOUT 15)
    if(NOT "${_smi_result}" STREQUAL "0")
      message(FATAL_ERROR "Cannot auto-detect the CUDA architecture: nvidia-smi failed (${_smi_result}): ${_smi_error}. ${_hint}")
    endif()
    string(REPLACE "\r" "" _smi_output "${_smi_output}")
    string(REPLACE "\n" ";" _capabilities "${_smi_output}")
    set(_requested "")
    foreach(_capability IN LISTS _capabilities)
      string(STRIP "${_capability}" _capability)
      if(_capability MATCHES "^([1-9][0-9]*)\\.([0-9])$")
        set(_requested "${CMAKE_MATCH_1}${CMAKE_MATCH_2}")
        break()
      endif()
    endforeach()
    if(NOT _requested)
      message(FATAL_ERROR "Cannot auto-detect the CUDA architecture: nvidia-smi reported no GPU with a valid compute capability. ${_hint}")
    endif()
    message(STATUS "CUDA architecture auto-detected with nvidia-smi: sm_${_requested}")
  endif()
  string(REGEX REPLACE "^sm_" "" _arch "${_requested}")
  if(NOT _arch MATCHES "^[1-9][0-9]+$")
    message(FATAL_ERROR "Choose one CUDA architecture, e.g. OPENMX_GPU_ARCH=80 or sm_80")
  endif()
  if(CMAKE_CUDA_ARCHITECTURES)
    if(NOT CMAKE_CUDA_ARCHITECTURES STREQUAL _arch AND
       NOT CMAKE_CUDA_ARCHITECTURES STREQUAL OPENMX_MANAGED_CUDA_ARCH)
      message(FATAL_ERROR "The selected CUDA architecture sm_${_arch} conflicts with CMAKE_CUDA_ARCHITECTURES=${CMAKE_CUDA_ARCHITECTURES}. Select the target with -DOPENMX_GPU_ARCH=sm_${_arch} and remove the conflicting CMAKE_CUDA_ARCHITECTURES setting.")
    endif()
  endif()
  set(CMAKE_CUDA_ARCHITECTURES "${_arch}" CACHE STRING "CUDA target architecture" FORCE)
  set(OPENMX_MANAGED_CUDA_ARCH "${_arch}" CACHE INTERNAL "Architecture last resolved by OpenMX")
  set(OPENMX_CUDA_ARCH "${_arch}" PARENT_SCOPE)
endfunction()

function(openmx_select_kokkos_cuda_architecture arch)
  # Names from the pinned Kokkos 5.2.2 release; no device query is needed.
  set(_names MAXWELL50 MAXWELL52 MAXWELL53 PASCAL60 PASCAL61 VOLTA70 VOLTA72
      TURING75 AMPERE80 AMPERE86 AMPERE87 ADA89 HOPPER90 BLACKWELL100
      BLACKWELL103 BLACKWELL120 BLACKWELL121)
  set(_selected "")
  foreach(_name IN LISTS _names)
    string(REGEX REPLACE "^[A-Z]+" "" _number "${_name}")
    if(_number STREQUAL arch)
      set(_selected "${_name}")
    endif()
  endforeach()
  if(NOT _selected)
    message(FATAL_ERROR "The pinned Kokkos does not support CUDA sm_${arch}")
  endif()
  if(OPENMX_MANAGED_KOKKOS_CUDA_ARCH AND NOT OPENMX_MANAGED_KOKKOS_CUDA_ARCH STREQUAL _selected)
    set(Kokkos_ARCH_${OPENMX_MANAGED_KOKKOS_CUDA_ARCH} OFF CACHE BOOL "" FORCE)
  endif()
  foreach(_name IN LISTS _names)
    if(Kokkos_ARCH_${_name} AND NOT _name STREQUAL _selected)
      message(FATAL_ERROR "Kokkos_ARCH_${_name} conflicts with OPENMX_GPU_ARCH=${arch}")
    endif()
  endforeach()
  set(Kokkos_ARCH_${_selected} ON CACHE BOOL "CUDA architecture selected by OpenMX" FORCE)
  set(OPENMX_MANAGED_KOKKOS_CUDA_ARCH "${_selected}" CACHE INTERNAL "Kokkos device architecture selected by OpenMX")
endfunction()
