  "production_changes_reviewed": [
    "source/backends/hip/src/Band_DFT_NonCol.c",
    "source/backends/hip/src/Cluster_DFT_NonCol_dm_hip.cu",
    "source/backends/hip/src/magma_openmx.cu",
