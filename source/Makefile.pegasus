# Pegasus (CCS, University of Tsukuba): H100 PCIe / Xeon Platinum 8468.
# Keep the application sources, dependency rules and numerical policies in
# the shared Makefile; standalone copies missed the C++/Kokkos migration.
# Build from source/: make -f Makefile.pegasus -j12 openmx
# A CMake >= 3.25.2 executable is required for the C++ core.

NVHPC_ROOT          ?= /system/apps/ubuntu/22.04-202604/nvhpc/26.5/Linux_x86_64/26.5
NVHPC_CUDA_VERSION  ?= 13.2
GEMMUL8_GPU_ARCH    ?= 90

# GCC 12 supplies the C++20 standard library for Kokkos and the CUDA
# adapters; use the same host compiler for the distributed solver stack.
NVCC_HOST           ?= /usr/bin/g++-12
OPENMX_CORE_CXX     ?= /usr/bin/g++-12
GPUSOLVER2_HOST_CC  ?= /usr/bin/gcc-12
GPUSOLVER2_HOST_CXX ?= /usr/bin/g++-12
GPUSOLVER2_JOBS     ?= 12

# Reuse the CMake previously bootstrapped by the bundled dependency build
# when present. Override PEGASUS_CMAKE for another installation.
PEGASUS_CMAKE ?= $(if $(wildcard $(CURDIR)/third_party/gpusolver2-install/cmake-bootstrap/bin/cmake),$(CURDIR)/third_party/gpusolver2-install/cmake-bootstrap/bin/cmake,cmake)
OPENMX_CORE_CMAKE ?= $(PEGASUS_CMAKE)
GPUSOLVER2_CMAKE ?= $(PEGASUS_CMAKE)
MAGMA_CMAKE ?= $(PEGASUS_CMAKE)

# One GPU per Pegasus node: the normal gpusolver path and distributed
# ELPA/COSMA path are available; MAGMA is an explicit optional build.
WITH_MAGMA ?= 0

include Makefile
