+                         reinterpret_cast<const blas_api::ComplexDoubleType*>(beta),
+                         reinterpret_cast<blas_api::ComplexDoubleType*>(c), lld_c);
+    }
+#endif
     return blas_api::zgemm(handle, op_a, op_b, m, n, k,
