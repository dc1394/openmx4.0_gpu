+
+    double *w1, *w2, result[4]={0, 0, 0, 0}, runused[1];
+    magma_int_t *iwork;
+    magma_int_t N, Nfound, Nfound_ref, n2, info, info_ref, lda, lwork, liwork;
+    magma_int_t info_eigval    = 0;
+    magma_int_t info_ortho     = 0;
+    magma_int_t info_reduction = 0;
+    magma_int_t ione = 1;
+    magma_int_t izero = 0;
+    int status = 0;
+
+    magma_opts opts;
+    opts.parse_opts( argc, argv );
+
+    double tol = opts.tolerance * lapackf77_dlamch("E");
+    double eps = lapackf77_dlamch("E");
+
+    /* --version 1 -> 1stage, 2 -> 2stage, anything else -> auto.
+       Exported BEFORE any solve so the driver's deterministic algorithm
+       choice (workspace query and solve) matches what is tested here. */
+    const char* algo_env = "auto";
+    if ( opts.version == 1 ) {
+        algo_env = "1stage";
+    }
+    else if ( opts.version == 2 ) {
+        algo_env = "2stage";
+    }
+    setenv( "MAGMA_OZAKI2_ALGO", algo_env, 1 );
+
+    const char* oz_global = getenv( "MAGMA_OZAKI2" );
+
+    printf("%% jobz = %s, uplo = %s, MAGMA_OZAKI2_ALGO = %s, MAGMA_OZAKI2 (global) = %s\n",
+           lapack_vec_const(opts.jobz), lapack_uplo_const(opts.uplo),
+           algo_env, (oz_global != NULL && oz_global[0] != '\0' ? oz_global : "unset"));
+    printf("%% Ozaki-II GEMM routing is enabled only while the _ozaki2 driver runs\n"
+           "%% (HIP builds with GEMMul8); the native reference runs unrouted.  Set\n"
+           "%% MAGMA_OZAKI2_VERBOSE=1 to see per-op routed/fallback statistics at exit.\n");
+    printf("%%   N     M   algo    ozaki2 (s)  native (s)  speedup   ||I-Q^H Q||/N   ||A-QDQ^H||/(||A||N)   |D_oz-D_nat|/|D_nat|\n");
+    printf("%%====================================================================================================================\n");
+    magma_int_t threads = magma_get_parallel_numthreads();
+    for( int itest = 0; itest < opts.ntest; ++itest ) {
+        for( int iter = 0; iter < opts.niter; ++iter ) {
+            N = opts.nsize[itest];
+            lda = N;
+            n2  = lda*N;
+
+            magma_range_t range;
+            magma_int_t il, iu;
+            double vl, vu;
+            opts.get_range( N, &range, &vl, &vu, &il, &iu );
+            /* fraction_lo=0 maps to il=0 via get_range, but LAPACK/MAGMA use a
+               1-based index range (1 <= il <= iu <= n); clamp il>=1 so the
+               bottom-fraction case (e.g. --fraction 0,0.2) is a valid range. */
+            if (range == MagmaRangeI && il < 1) il = 1;
+
+            /* replicate the driver's deterministic algorithm choice, to run
+               the matching native reference (2-stage is lower-only).
+               auto: nev = iu-il+1 for RangeI, else N (RangeAll/RangeV full);
+               2-stage iff N >= 2048 && (2*nev <= N || N <= 3072). */
+            magma_int_t nev = (range == MagmaRangeI) ? (iu - il + 1) : N;
+            magma_int_t use_2stage = (opts.uplo == MagmaLower)
+                && ( opts.version == 2
+                     || (opts.version != 1
+                         && N >= 2048 && (2*nev <= N || N <= 3072)) );
+
+            /* Workspace: max of the 1-stage and 2-stage requirements, so the
+               same arrays fit both the ozaki2 run and the native reference. */
+            magma_int_t lwork1, liwork1, lwork2, liwork2;
+            #ifdef COMPLEX
+            magma_int_t lrwork1, lrwork2;
+            #endif
+
+            // 2-stage requirements
+            magma_zheevdx_getworksize(N, threads, (opts.jobz == MagmaVec),
+                                     &lwork2,
+                                     #ifdef COMPLEX
+                                     &lrwork2,
+                                     #endif
+                                     &liwork2);
+
+            // 1-stage requirements (formulas from magma_zheevdx)
+            magma_int_t nb = magma_get_zhetrd_nb( N );
+            #ifdef COMPLEX
+            if ( opts.jobz == MagmaVec ) {
+                lwork1  = max( N + N*nb, 2*N + N*N );
+                lrwork1 = 1 + 5*N + 2*N*N;
+                liwork1 = 3 + 5*N;
+            } else {
+                lwork1  = N + N*nb;
+                lrwork1 = N;
+                liwork1 = 1;
+            }
+            #else
+            if ( opts.jobz == MagmaVec ) {
+                lwork1  = max( 2*N + N*nb, 1 + 6*N + 2*N*N );
+                liwork1 = 3 + 5*N;
+            } else {
+                lwork1  = 2*N + N*nb;
+                liwork1 = 1;
+            }
+            #endif
+
+            lwork  = max( lwork1,  lwork2 );
+            liwork = max( liwork1, liwork2 );
+            liwork = max( liwork, 5*N );        // small-N LAPACK fallbacks
+            #ifdef COMPLEX
+            lrwork = max( lrwork1, lrwork2 );
+            lrwork = max( lrwork, 7*N );        // small-N LAPACK fallbacks
+            #endif
+
+            /* Allocate host memory for the matrix */
+            TESTING_CHECK( magma_zmalloc_cpu( &h_A,   n2 ));
+            TESTING_CHECK( magma_dmalloc_cpu( &w1,    N ));
+            TESTING_CHECK( magma_dmalloc_cpu( &w2,    N ));
+            TESTING_CHECK( magma_imalloc_cpu( &iwork, liwork ));
+
+            TESTING_CHECK( magma_zmalloc_pinned( &h_R,    n2    ));
+            TESTING_CHECK( magma_zmalloc_pinned( &h_Rref, n2    ));
+            TESTING_CHECK( magma_zmalloc_pinned( &h_work, lwork ));
+            #ifdef COMPLEX
+            TESTING_CHECK( magma_dmalloc_pinned( &rwork, lrwork ));
+            #endif
+
+            /* Initialize the matrix */
+            magma_generate_matrix( opts, N, N, h_A, lda );
+
+            if (opts.warmup) {
+                // ==================================================================
+                // Warmup using MAGMA
+                // ==================================================================
+                lapackf77_zlacpy( MagmaFullStr, &N, &N, h_A, &lda, h_R, &lda );
+                magma_zheevdx_ozaki2( opts.jobz, range, opts.uplo, N,
+                                      h_R, lda,
+                                      vl, vu, il, iu,
+                                      &Nfound, w1,
+                                      h_work, lwork,
+                                      #ifdef COMPLEX
+                                      rwork, lrwork,
+                                      #endif
+                                      iwork, liwork,
+                                      &info );
+            }
+
+            // ===================================================================
+            // Performs operation using MAGMA (Ozaki-II driver)
+            // ===================================================================
+            lapackf77_zlacpy( MagmaFullStr, &N, &N, h_A, &lda, h_R, &lda );
+            oz_time = magma_wtime();
+            magma_zheevdx_ozaki2( opts.jobz, range, opts.uplo, N,
+                                  h_R, lda,
+                                  vl, vu, il, iu,
+                                  &Nfound, w1,
+                                  h_work, lwork,
+                                  #ifdef COMPLEX
+                                  rwork, lrwork,
+                                  #endif
+                                  iwork, liwork,
+                                  &info );
+            oz_time = magma_wtime() - oz_time;
+            if (info != 0) {
+                printf("magma_zheevdx_ozaki2 returned error %lld: %s.\n",
+                       (long long) info, magma_strerror( info ));
+            }
+
+            // ===================================================================
+            // Native reference (same algorithm, fresh copy, no ozaki2 scope)
+            // ===================================================================
+            lapackf77_zlacpy( MagmaFullStr, &N, &N, h_A, &lda, h_Rref, &lda );
+            ref_time = magma_wtime();
+            if ( use_2stage ) {
+                magma_zheevdx_2stage( opts.jobz, range, opts.uplo, N,
+                                      h_Rref, lda,
+                                      vl, vu, il, iu,
+                                      &Nfound_ref, w2,
+                                      h_work, lwork,
+                                      #ifdef COMPLEX
+                                      rwork, lrwork,
+                                      #endif
+                                      iwork, liwork,
+                                      &info_ref );
+            }
+            else {
+                magma_zheevdx( opts.jobz, range, opts.uplo, N,
+                               h_Rref, lda,
+                               vl, vu, il, iu,
+                               &Nfound_ref, w2,
+                               h_work, lwork,
+                               #ifdef COMPLEX
+                               rwork, lrwork,
+                               #endif
+                               iwork, liwork,
+                               &info_ref );
+            }
+            ref_time = magma_wtime() - ref_time;
+            if (info_ref != 0) {
+                printf("native reference returned error %lld: %s.\n",
+                       (long long) info_ref, magma_strerror( info_ref ));
+            }
+
+            printf("%5lld %5lld  %-6s  %9.2f   %9.2f   %7.2f  ",
+                   (long long) N, (long long) Nfound,
+                   (use_2stage ? "2stage" : "1stage"),
+                   oz_time, ref_time, ref_time / oz_time );
+
+            if ( opts.check ) {
+                info_eigval    = 0;
+                info_ortho     = 0;
+                info_reduction = 0;
+
+                /* Check the orthogonality and reduction of the OZAKI2 result */
+                if (opts.jobz == MagmaVec) {
+                    /* =====================================================================
+                       Following the LAPACK's [zcds]drvst routine.
+                       A is factored as A = U S U^H and the following 2 tests computed:
+                       (1)    | A - U S U^H | / ( |A| N ) if all eigenvectors were computed
+                              | U^H A U - S | / ( |A| Nfound ) otherwise
+                       (2)    | I - U^H U   | / ( N )
+                       =================================================================== */
+                    magmaDoubleComplex* work;
+                    TESTING_CHECK( magma_zmalloc_cpu( &work, 2*N*N ));
+
+                    // e is unused since kband=0; tau is unused since itype=1
+                    if( Nfound == N ) {
+                        lapackf77_zhet21( &ione, lapack_uplo_const(opts.uplo), &N, &izero,
+                                          h_A, &lda,
+                                          w1, runused,
+                                          h_R, &lda,
+                                          h_R, &lda,
+                                          unused, work,
+                                          #ifdef COMPLEX
+                                          rwork,
+                                          #endif
+                                          &result[0] );
+                    } else {
+                        lapackf77_zhet22( &ione, lapack_uplo_const(opts.uplo), &N, &Nfound, &izero,
+                                          h_A, &lda,
+                                          w1, runused,
+                                          h_R, &lda,
+                                          h_R, &lda,
+                                          unused, work,
+                                          #ifdef COMPLEX
+                                          rwork,
+                                          #endif
+                                          &result[0] );
+                    }
+                    result[0] *= eps;
+                    result[1] *= eps;
+                    info_reduction = ! (result[0] < tol);
+                    info_ortho     = ! (result[1] < tol);
+                    printf("     %8.2e         %8.2e       ", result[1], result[0] );
+                    magma_free_cpu( work );  work=NULL;
+                } else {
+                    printf("        ---              ---        ");
+                }
+
+                /* Max relative eigenvalue difference vs the native driver */
+                double maxrel = 0;
+                if ( Nfound != Nfound_ref ) {
+                    printf("     Nfound mismatch (native %lld)", (long long) Nfound_ref );
+                    info_eigval = 1;
+                } else {
+                    info_eigval = check_eigenvalues( Nfound, w2, w1, eps, &maxrel );
+                    printf("        %8.2e", maxrel );
+                }
+
+                bool okay = (info == 0) && (info_ref == 0)
+                         && (info_eigval == 0) && (info_ortho == 0) && (info_reduction == 0);
+                status += ! okay;
+                printf("   %s", (okay ? "ok" : "failed"));
+            }
+            printf("\n");
+
+            magma_free_cpu( h_A   );
+            magma_free_cpu( w1    );
+            magma_free_cpu( w2    );
+            magma_free_cpu( iwork );
+
+            magma_free_pinned( h_R    );
+            magma_free_pinned( h_Rref );
+            magma_free_pinned( h_work );
+            #ifdef COMPLEX
+            magma_free_pinned( rwork  );
+            #endif
+            fflush( stdout );
+        }
+        if ( opts.niter > 1 ) {
+            printf( "\n" );
+        }
+    }
+
+    opts.cleanup();
+    TESTING_CHECK( magma_finalize() );
+    return status;
+}
+
+
+/*------------------------------------------------------------
+ *  Check the eigenvalues (ozaki2 vs native driver):
+ *  maxrel = max_i |E[i] - E_ref[i]| / max(unfl, max_i |E_ref[i]|).
+ *  Failed when maxrel > 1000*eps (Ozaki-II with the default 15 moduli
+ *  should be far below), or NaN/Inf.
+ */
+static magma_int_t check_eigenvalues(magma_int_t Nfound, double *E_ref, double *E, double eps, double *maxrel)
+{
+    double unfl   = lapackf77_dlamch("Safe minimum");
+    double maxdif = 0;
+    double maxeig = 0;
+    for (magma_int_t i = 0; i < Nfound; i++) {
+        maxdif = max( maxdif, fabs( E[i] - E_ref[i] ) );
+        maxeig = max( maxeig, fabs( E_ref[i] ) );
+    }
+    *maxrel = maxdif / max( unfl, maxeig );
+
+    if (std::isnan(*maxrel) || std::isinf(*maxrel) || (*maxrel > 1000*eps)) {
+        return 1;
+    }
+    return 0;
+}
