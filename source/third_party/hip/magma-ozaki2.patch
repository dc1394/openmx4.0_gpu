+        maxeig = max( maxeig, fabs( E_ref[i] ) );
+    }
+    *maxrel = maxdif / max( unfl, maxeig );
+
+    if (std::isnan(*maxrel) || std::isinf(*maxrel) || (*maxrel > 1000*eps)) {
+        return 1;
+    }
+    return 0;
+}
