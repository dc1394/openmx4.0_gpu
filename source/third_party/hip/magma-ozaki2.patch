+extern "C" magma_int_t
+magma_ozaki2_try_zher2k(
+    magma_uplo_t uplo, magma_trans_t trans,
+    magma_int_t n, magma_int_t k,
+    magmaDoubleComplex alpha,
+    const magmaDoubleComplex *dA, magma_int_t ldda,
+    const magmaDoubleComplex *dB, magma_int_t lddb,
+    double beta,
+    magmaDoubleComplex       *dC, magma_int_t lddc,
+    magma_queue_t queue )
+{
+    if (! magma_ozaki2_active())
+        return 0;
+    const OzConfig& c = oz_config();
+    if (! oz_op_enabled( OZ_HER2K ))
+        return oz_reject_gate( OZ_HER2K, "op disabled", n, n, k );
+    hipblasFillMode_t huplo;
+    if (! oz_map_uplo( uplo, &huplo ))
+        return oz_reject_gate( OZ_HER2K, "bad uplo", n, n, k );
+    // GEMMul8 her2k only supports OP_N / OP_C (never OP_T)
+    hipblasOperation_t htrans;
+    if (trans == MagmaNoTrans)
+        htrans = HIPBLAS_OP_N;
+    else if (trans == MagmaConjTrans)
+        htrans = HIPBLAS_OP_C;
+    else
+        return oz_reject_gate( OZ_HER2K, "bad trans", n, n, k );
+    if (! oz_size_gate_ok( n, n, k, true, OZ_HER2K ))
+        return oz_reject_gate( OZ_HER2K, "size gate", n, n, k );
+
+    std::lock_guard<std::mutex> lock( g_mutex );
+    OzEntry* e = oz_get_entry( queue );
+    if (e == NULL)
+        return oz_reject_ws( OZ_HER2K, "handle", 0 );
+    size_t wsz = gemmul8::workSize<true, gemmul8::Backend::INT8, gemmul8::Func::her2k>(
+        (size_t) n, (size_t) n, (size_t) k, c.num_moduli );
+    if (! oz_ensure_ws( e, wsz ))
+        return oz_reject_ws( OZ_HER2K, "workspace", wsz );
+
+    hipDoubleComplex h_alpha = *reinterpret_cast<const hipDoubleComplex*>( &alpha );
+    double           h_beta  = beta;   // her2k beta is REAL (const double*)
+    (void) gemmul8::her2k<hipDoubleComplex, gemmul8::Backend::INT8>(
+        e->handle, huplo, htrans,
+        (size_t) n, (size_t) k,
+        &h_alpha, reinterpret_cast<const hipDoubleComplex*>( dA ), (size_t) ldda,
+                  reinterpret_cast<const hipDoubleComplex*>( dB ), (size_t) lddb,
+        &h_beta,  reinterpret_cast<hipDoubleComplex*>( dC ),       (size_t) lddc,
+        c.num_moduli, c.fastmode, e->ws );
