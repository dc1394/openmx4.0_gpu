+    OZ_SYR2K,
+    OZ_HER2K,
+    OZ_TRMM,
+    OZ_NUM_OPS
+};
+
+const char* const oz_op_names[OZ_NUM_OPS] =
+    { "gemm", "symm", "hemm", "syr2k", "her2k", "trmm" };
+
+struct OzStats {
+    std::atomic<unsigned long long> routed        {0};
+    std::atomic<unsigned long long> fallback_ws   {0};
+    std::atomic<unsigned long long> fallback_gate {0};
+};
+
+OzStats g_stats[OZ_NUM_OPS];
+
+// =============================================================================
+// Configuration (parsed once from the environment)
+// =============================================================================
+
+// -----------------------------------------------------------------------------
+// Size-gate defaults retuned 2026-07-02 from a gfx1200 (RX 9060 XT, 16 GiB)
+// microbenchmark: MAGMA-native hipBLAS/rocBLAS vs GEMMul8 INT8 (num_moduli
+// 15), 48 shapes across gemm/symm/hemm/syr2k/her2k/trmm in double and
+// double-complex.  Findings: Ozaki-II wins iff the gemm-equivalent inner
+// dimension keff is large (squares 3.8x-18.4x, dlaex3 shapes 3.8x-11x,
+// symm/hemm 2.3x-3.6x); REAL always loses for keff <= 128 regardless of
+// m*n*k (worst 2.85x, and even m*n*k = 4.0e9 at keff=128 loses 1.15x);
+// COMPLEX loses for keff <= 64, and for keff = 128 when m*n*keff < ~1e8.
+// Routing rule (per dtype, on the gemm-equivalent dims m, n, keff):
+//     route iff min(m, n, keff) >= min_dim
+//           AND keff >= min_k
+//           AND m*n*keff >= min_mnk  (x trmm_mnk_mult for trmm, whose
+//                                     Ozaki path pays an extra out-of-place
+//                                     temp + copy-back)
+// with real defaults (128, 256, 2^28) and complex defaults (64, 128, 2^27).
+// Against the 48 measured shapes this routes 30 calls (all wins, worst
+// routed ratio 0.85 ozaki/native) and routes ZERO losses.  Thresholds are
+// specific to fp64-weak GPUs (gfx1200 native dgemm ~0.32 TFLOP/s); re-tune
+// on hardware with stronger fp64.
+//
+// Env overrides (all optional; a base var applies to BOTH dtypes unless the
+// corresponding _CPLX var is also set):
+//     MAGMA_OZAKI2_MIN_DIM        min(m,n,keff) gate; real default 128
+//     MAGMA_OZAKI2_MIN_DIM_CPLX   complex min_dim (default 64)
+//     MAGMA_OZAKI2_MIN_K          keff gate; real default 256
+//     MAGMA_OZAKI2_MIN_K_CPLX     complex min_k (default 128)
+//     MAGMA_OZAKI2_MIN_MNK        m*n*keff gate; real default 268435456
+//     MAGMA_OZAKI2_MIN_MNK_CPLX   complex min_mnk (default 134217728)
+//     MAGMA_OZAKI2_TRMM_MNK_MULT  min_mnk multiplier for trmm (default 4)
+//     MAGMA_OZAKI2_MIN_FREE_MB    VRAM headroom (MiB) a workspace grow must
+//                                 leave free (default 2048)
+//     MAGMA_OZAKI2_LOCAL_RANKS    processes sharing this GPU; divides the
+//                                 percent-based workspace cap (default:
+//                                 OMPI_COMM_WORLD_LOCAL_SIZE, then
+//                                 SLURM_NTASKS_PER_NODE, then 1)
+// -----------------------------------------------------------------------------
+
+struct OzConfig {
+    bool               global_on      = false;         // MAGMA_OZAKI2
+    int                num_moduli     = 15;            // MAGMA_OZAKI2_NUM_MODULI
+    bool               fastmode       = false;         // MAGMA_OZAKI2_FASTMODE
+    long long          min_dim        = 128;           // MAGMA_OZAKI2_MIN_DIM (real)
+    long long          min_dim_cplx   = 64;            // MAGMA_OZAKI2_MIN_DIM_CPLX
+    long long          min_k          = 256;           // MAGMA_OZAKI2_MIN_K (real)
+    long long          min_k_cplx     = 128;           // MAGMA_OZAKI2_MIN_K_CPLX
+    unsigned long long min_mnk        = 1ULL << 28;    // MAGMA_OZAKI2_MIN_MNK (real)
+    unsigned long long min_mnk_cplx   = 1ULL << 27;    // MAGMA_OZAKI2_MIN_MNK_CPLX
+    unsigned long long trmm_mnk_mult  = 4;             // MAGMA_OZAKI2_TRMM_MNK_MULT
+    size_t             max_ws_mb      = 0;             // MAGMA_OZAKI2_MAX_WS_MB (0 = unset)
+    int                max_ws_percent = -1;            // MAGMA_OZAKI2_MAX_WS_PERCENT (-1 = unset)
+    long long          min_free_mb    = 2048;          // MAGMA_OZAKI2_MIN_FREE_MB
+    int                local_ranks    = 1;             // MAGMA_OZAKI2_LOCAL_RANKS (else OMPI/Slurm)
+    unsigned           ops_mask       = (1u << OZ_NUM_OPS) - 1;  // MAGMA_OZAKI2_OPS
+    int                verbose        = 0;             // MAGMA_OZAKI2_VERBOSE
+};
+
+OzConfig       g_cfg;
+std::once_flag g_cfg_once;
+
+// process-wide routing scope depth (NOT thread_local: the 2-stage
+// eigensolvers spawn pthreads that issue magma_* BLAS calls)
+std::atomic<int> g_depth{0};
+
+long long oz_env_ll( const char* name, long long dflt )
+{
+    const char* s = getenv( name );
+    if (s == NULL || *s == '\0')
+        return dflt;
+    char* end = NULL;
+    long long v = strtoll( s, &end, 10 );
+    if (end == s)
+        return dflt;
+    return v;
+}
+
+bool oz_env_set( const char* name )
+{
+    const char* s = getenv( name );
+    return (s != NULL && *s != '\0');
+}
+
+void oz_stats_atexit()
+{
+    magma_ozaki2_print_stats();
+}
+
+void oz_parse_ops_csv( const char* s, unsigned* mask )
+{
+    unsigned m = 0;
+    std::string buf( s );
+    size_t pos = 0;
+    while (pos <= buf.size()) {
+        size_t comma = buf.find( ',', pos );
+        if (comma == std::string::npos)
+            comma = buf.size();
+        std::string tok = buf.substr( pos, comma - pos );
+        // trim blanks
+        while (! tok.empty() && (tok.front() == ' ' || tok.front() == '\t'))
+            tok.erase( tok.begin() );
+        while (! tok.empty() && (tok.back() == ' ' || tok.back() == '\t'))
+            tok.pop_back();
+        for (char& c : tok)
+            c = (char) tolower( (unsigned char) c );
+        if (! tok.empty()) {
+            bool found = false;
+            for (int op = 0; op < OZ_NUM_OPS; ++op) {
+                if (tok == oz_op_names[op]) {
+                    m |= (1u << op);
+                    found = true;
+                    break;
+                }
+            }
+            if (! found) {
+                fprintf( stderr, "MAGMA ozaki2: warning: unknown op '%s' in "
+                         "MAGMA_OZAKI2_OPS (valid: gemm,symm,hemm,syr2k,her2k,trmm)\n",
+                         tok.c_str() );
+            }
+        }
+        pos = comma + 1;
+    }
+    *mask = m;
+}
+
+void oz_init_config()
+{
+    g_cfg.global_on = (oz_env_ll( "MAGMA_OZAKI2", 0 ) != 0);
+
+    long long nm = oz_env_ll( "MAGMA_OZAKI2_NUM_MODULI", 15 );
+    if (nm < 2)  nm = 2;
+    if (nm > 20) nm = 20;
+    g_cfg.num_moduli = (int) nm;
+
+    g_cfg.fastmode = (oz_env_ll( "MAGMA_OZAKI2_FASTMODE", 0 ) != 0);
+
+    // size gates: defaults from the 2026-07-02 gfx1200 microbenchmark (see
+    // the comment above OzConfig); the base var overrides both dtypes, the
+    // _CPLX var overrides the complex gate only
+    long long md = oz_env_ll( "MAGMA_OZAKI2_MIN_DIM", 128 );
+    if (md < 1) md = 1;
+    g_cfg.min_dim = md;
+
+    long long mdc = oz_env_ll( "MAGMA_OZAKI2_MIN_DIM_CPLX",
+                               oz_env_set( "MAGMA_OZAKI2_MIN_DIM" ) ? md : 64 );
+    if (mdc < 1) mdc = 1;
+    g_cfg.min_dim_cplx = mdc;
+
+    long long mk = oz_env_ll( "MAGMA_OZAKI2_MIN_K", 256 );
+    if (mk < 1) mk = 1;
+    g_cfg.min_k = mk;
+
+    long long mkc = oz_env_ll( "MAGMA_OZAKI2_MIN_K_CPLX",
+                               oz_env_set( "MAGMA_OZAKI2_MIN_K" ) ? mk : 128 );
+    if (mkc < 1) mkc = 1;
+    g_cfg.min_k_cplx = mkc;
+
+    long long mnk = oz_env_ll( "MAGMA_OZAKI2_MIN_MNK", (long long)(1LL << 28) );
+    if (mnk < 0) mnk = 0;
+    g_cfg.min_mnk = (unsigned long long) mnk;
+
+    long long mnkc = oz_env_ll( "MAGMA_OZAKI2_MIN_MNK_CPLX",
+                                oz_env_set( "MAGMA_OZAKI2_MIN_MNK" )
+                                    ? mnk : (long long)(1LL << 27) );
+    if (mnkc < 0) mnkc = 0;
+    g_cfg.min_mnk_cplx = (unsigned long long) mnkc;
+
+    long long tmm = oz_env_ll( "MAGMA_OZAKI2_TRMM_MNK_MULT", 4 );
+    if (tmm < 1) tmm = 1;
+    g_cfg.trmm_mnk_mult = (unsigned long long) tmm;
+
+    long long mb = oz_env_ll( "MAGMA_OZAKI2_MAX_WS_MB", 0 );
+    if (mb < 0) mb = 0;
+    g_cfg.max_ws_mb = (size_t) mb;
+
+    long long pct = oz_env_ll( "MAGMA_OZAKI2_MAX_WS_PERCENT", -1 );
+    if (pct > 100) pct = 100;
+    g_cfg.max_ws_percent = (int) pct;   // -1 = unset
+
+    // refuse to grow the workspace unless at least this much VRAM stays
+    // free afterwards (headroom for MAGMA's own device allocations, whose
+    // failure is a hard driver error rather than a graceful fallback)
+    long long mfree = oz_env_ll( "MAGMA_OZAKI2_MIN_FREE_MB", 2048 );
+    if (mfree < 0) mfree = 0;
+    g_cfg.min_free_mb = mfree;
+
+    // processes sharing this GPU: the percent-based workspace cap is divided
+    // between them (mirrors OpenMX's gemmul8_bridge policy).  Explicit
+    // MAGMA_OZAKI2_LOCAL_RANKS wins; else OpenMPI / Slurm per-node counts.
+    long long lr = oz_env_ll( "MAGMA_OZAKI2_LOCAL_RANKS", 0 );
+    if (lr <= 0) lr = oz_env_ll( "OMPI_COMM_WORLD_LOCAL_SIZE", 0 );
+    if (lr <= 0) lr = oz_env_ll( "SLURM_NTASKS_PER_NODE", 0 );
+    if (lr <= 0) lr = 1;
+    g_cfg.local_ranks = (int) lr;
+
+    const char* ops = getenv( "MAGMA_OZAKI2_OPS" );
+    if (ops != NULL && *ops != '\0')
+        oz_parse_ops_csv( ops, &g_cfg.ops_mask );
+
+    long long vb = oz_env_ll( "MAGMA_OZAKI2_VERBOSE", 0 );
+    if (vb < 0) vb = 0;
+    g_cfg.verbose = (int) vb;
+
+    if (g_cfg.verbose >= 1) {
+        fprintf( stderr, "MAGMA ozaki2: config global=%d num_moduli=%d fastmode=%d "
+                 "min_dim=%lld/%lld min_k=%lld/%lld min_mnk=%llu/%llu "
+                 "(real/cplx) trmm_mnk_mult=%llu max_ws_mb=%zu max_ws_percent=%d "
+                 "min_free_mb=%lld local_ranks=%d ops_mask=0x%x verbose=%d\n",
+                 (int) g_cfg.global_on, g_cfg.num_moduli, (int) g_cfg.fastmode,
+                 g_cfg.min_dim, g_cfg.min_dim_cplx,
+                 g_cfg.min_k, g_cfg.min_k_cplx,
+                 g_cfg.min_mnk, g_cfg.min_mnk_cplx,
+                 g_cfg.trmm_mnk_mult, g_cfg.max_ws_mb,
+                 g_cfg.max_ws_percent, g_cfg.min_free_mb, g_cfg.local_ranks,
+                 g_cfg.ops_mask, g_cfg.verbose );
+        std::atexit( oz_stats_atexit );
+    }
+}
+
+const OzConfig& oz_config()
+{
+    std::call_once( g_cfg_once, oz_init_config );
+    return g_cfg;
+}
+
+// =============================================================================
+// Per-(device, stream) hipBLAS handle + grow-only workspace cache.
+// NEVER use the magma queue's own hipblas handle: GEMMul8 installs a
+// workspace on the handle it is given (hipblasSetWorkspace), which must
+// not leak into MAGMA's queue-owned handle.
+// =============================================================================
+
+struct OzEntry {
+    int             device   = -1;
+    hipStream_t     stream   = NULL;
+    hipblasHandle_t handle   = NULL;
+    void*           ws       = NULL;
+    size_t          ws_bytes = 0;
+    size_t          cap      = 0;    // max allowed workspace bytes
+};
+
+// held across each routed call: protects the cache AND serializes use of a
+// (device,stream) workspace against concurrent growth/free
+std::mutex g_mutex;
+std::map< std::pair<int, hipStream_t>, OzEntry > g_entries;
+
+size_t oz_compute_cap( int device )
+{
+    const OzConfig& c = oz_config();
+
+    size_t cap_mb  = 0;
+    size_t cap_pct = 0;
+    bool   have_mb  = (c.max_ws_mb > 0);
+    bool   have_pct = false;
+
+    if (have_mb)
+        cap_mb = c.max_ws_mb << 20;
+
+    // percent cap applies when explicitly set, or as the default (30 %)
+    // when no MB cap is given; it is divided between the processes sharing
+    // this GPU (local_ranks).  The MB cap is absolute per process.
+    int pct = c.max_ws_percent;
+    if (pct < 0 && ! have_mb)
+        pct = 30;
+    if (pct >= 0) {
+        size_t total = 0;
+        if (hipDeviceTotalMem( &total, device ) == hipSuccess && total > 0) {
+            cap_pct  = total / 100 * (size_t) pct / (size_t) c.local_ranks;
+            have_pct = true;
+        }
+    }
+
+    if (have_mb && have_pct)
+        return (cap_mb < cap_pct) ? cap_mb : cap_pct;
+    if (have_mb)
+        return cap_mb;
+    if (have_pct)
+        return cap_pct;
+    // VRAM query failed and no MB cap given: conservative 2 GiB, rank-divided
+    return ((size_t) 2 << 30) / (size_t) c.local_ranks;
+}
+
+// requires g_mutex held
+OzEntry* oz_get_entry( magma_queue_t queue )
+{
+    int         device = (int) magma_queue_get_device( queue );
+    hipStream_t stream = magma_queue_get_hip_stream( queue );
+
+    auto key = std::make_pair( device, stream );
+    auto it  = g_entries.find( key );
+    if (it != g_entries.end())
+        return &it->second;
+
+    OzEntry e;
+    e.device = device;
+    e.stream = stream;
+    if (hipblasCreate( &e.handle ) != HIPBLAS_STATUS_SUCCESS)
+        return NULL;
+    if (hipblasSetStream( e.handle, stream ) != HIPBLAS_STATUS_SUCCESS) {
+        hipblasDestroy( e.handle );
+        return NULL;
+    }
+    e.cap = oz_compute_cap( device );
+    // GEMMul8 v3.4.x memory-saving mode: a GEMM whose full workspace
+    // exceeds the cap is executed in blocks that fit it, instead of this
+    // adapter refusing the call.  Handle-local, so MAGMA's own handle is
+    // unaffected; ops without a blocked path simply see workspaces that
+    // already fit (their calls still ensure the full size below).
+    gemmul8::set_memory_saving( e.handle, true );
+    gemmul8::set_max_worksize( e.handle, e.cap );
+
+    auto res = g_entries.emplace( key, e );
+    return &res.first->second;
+}
+
+// requires g_mutex held; grow-only workspace
+bool oz_ensure_ws( OzEntry* e, size_t bytes )
+{
+    if (bytes <= e->ws_bytes)
+        return true;
+    if (bytes > e->cap)
+        return false;
+    if (e->ws != NULL) {
+        // hipFree synchronizes the device, so in-flight users are safe
+        (void) hipFree( e->ws );
+        e->ws       = NULL;
+        e->ws_bytes = 0;
+    }
+    // leave headroom: MAGMA's own device allocations fail hard (info=-113)
+    // while our denial is a graceful native fallback
+    {
+        size_t free_b = 0, total_b = 0;
+        size_t reserve = (size_t) oz_config().min_free_mb << 20;
+        if (hipMemGetInfo( &free_b, &total_b ) == hipSuccess) {
+            if (free_b < bytes || free_b - bytes < reserve)
+                return false;
+        }
+    }
+    void* p = NULL;
+    if (hipMalloc( &p, bytes ) != hipSuccess || p == NULL)
+        return false;
+    e->ws       = p;
+    e->ws_bytes = bytes;
+    return true;
+}
+
+// =============================================================================
+// Gates, enum mapping, stats helpers
+// =============================================================================
+
+// map magma_trans_t -> hipblasOperation_t; for real ops ConjTrans -> OP_T
+bool oz_map_trans( magma_trans_t t, bool is_real, hipblasOperation_t* out )
+{
+    switch (t) {
+        case MagmaNoTrans:   *out = HIPBLAS_OP_N; return true;
+        case MagmaTrans:     *out = HIPBLAS_OP_T; return true;
+        case MagmaConjTrans: *out = is_real ? HIPBLAS_OP_T : HIPBLAS_OP_C; return true;
+        default:             return false;
+    }
+}
+
+// GEMMul8 never accepts FILL_MODE_FULL
+bool oz_map_uplo( magma_uplo_t u, hipblasFillMode_t* out )
+{
+    switch (u) {
+        case MagmaUpper: *out = HIPBLAS_FILL_MODE_UPPER; return true;
+        case MagmaLower: *out = HIPBLAS_FILL_MODE_LOWER; return true;
+        default:         return false;
+    }
+}
+
+bool oz_map_side( magma_side_t s, hipblasSideMode_t* out )
+{
+    switch (s) {
+        case MagmaLeft:  *out = HIPBLAS_SIDE_LEFT;  return true;
+        case MagmaRight: *out = HIPBLAS_SIDE_RIGHT; return true;
+        default:         return false;
+    }
+}
+
+bool oz_map_diag( magma_diag_t d, hipblasDiagType_t* out )
+{
+    switch (d) {
+        case MagmaNonUnit: *out = HIPBLAS_DIAG_NON_UNIT; return true;
+        case MagmaUnit:    *out = HIPBLAS_DIAG_UNIT;     return true;
+        default:           return false;
+    }
+}
+
+// size gates on the gemm-equivalent dimension triple (m, n, keff), split by
+// dtype (real vs complex) with an extra keff (inner-dimension) threshold —
+// see the retuning comment above OzConfig: on gfx1200 the inner dimension,
+// not m*n*k, decides real-precision profitability.
+// NDEBUG is set in MAGMA builds, so GEMMul8's own asserts vanish —
+// these gates (plus the enum mapping above) are the only protection.
+bool oz_size_gate_ok( magma_int_t m, magma_int_t n, magma_int_t keff,
+                      bool is_cplx, OzOp op )
+{
+    const OzConfig& c = oz_config();
+    if (m <= 0 || n <= 0 || keff <= 0)
+        return false;
+    long long         min_dim = is_cplx ? c.min_dim_cplx : c.min_dim;
+    long long         min_k   = is_cplx ? c.min_k_cplx   : c.min_k;
+    unsigned __int128 min_mnk = is_cplx ? c.min_mnk_cplx : c.min_mnk;
+    if (op == OZ_TRMM) {
+        // trmm's Ozaki path pays an extra out-of-place temp + copy-back
+        min_mnk *= (unsigned __int128) c.trmm_mnk_mult;
+    }
+    if ((long long) m < min_dim || (long long) n < min_dim ||
+        (long long) keff < min_dim)
+        return false;
+    if ((long long) keff < min_k)
+        return false;
+    unsigned __int128 mnk = (unsigned __int128)(unsigned long long) m
+                          * (unsigned long long) n
+                          * (unsigned long long) keff;
+    if (mnk < min_mnk)
+        return false;
+    return true;
+}
+
+bool oz_op_enabled( OzOp op )
+{
+    return (oz_config().ops_mask & (1u << op)) != 0;
+}
+
+magma_int_t oz_reject_gate( OzOp op, const char* why,
+                            long long m, long long n, long long k )
+{
+    g_stats[op].fallback_gate.fetch_add( 1, std::memory_order_relaxed );
+    if (oz_config().verbose >= 2) {
+        fprintf( stderr, "MAGMA ozaki2: %-5s fallback (%s) m=%lld n=%lld k=%lld\n",
+                 oz_op_names[op], why, m, n, k );
+    }
+    return 0;
+}
+
+magma_int_t oz_reject_ws( OzOp op, const char* why, size_t bytes )
+{
+    g_stats[op].fallback_ws.fetch_add( 1, std::memory_order_relaxed );
+    if (oz_config().verbose >= 2) {
+        fprintf( stderr, "MAGMA ozaki2: %-5s fallback (%s) bytes=%zu\n",
+                 oz_op_names[op], why, bytes );
+    }
+    return 0;
+}
+
+void oz_routed( OzOp op, long long m, long long n, long long k )
+{
+    g_stats[op].routed.fetch_add( 1, std::memory_order_relaxed );
+    if (oz_config().verbose >= 2) {
+        fprintf( stderr, "MAGMA ozaki2: %-5s routed   m=%lld n=%lld k=%lld\n",
+                 oz_op_names[op], m, n, k );
+    }
+}
+
+constexpr size_t OZ_ALIGN = 256;
+
+inline size_t oz_round_up( size_t bytes )
+{
+    return (bytes + (OZ_ALIGN - 1)) & ~(OZ_ALIGN - 1);
+}
