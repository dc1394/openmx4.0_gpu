+/*------------------------------------------------------------
+ *  Check the eigenvalues (ozaki2 vs native driver):
+ *  maxrel = max_i |E[i] - E_ref[i]| / max(unfl, max_i |E_ref[i]|).
+ *  Failed when maxrel > 1000*eps (Ozaki-II with the default 15 moduli
+ *  should be far below), or NaN/Inf.
+ */
+static magma_int_t check_eigenvalues(magma_int_t Nfound, double *E_ref, double *E, double eps, double *maxrel)
+{
+    double unfl   = lapackf77_dlamch("Safe minimum");
+    double maxdif = 0;
+    double maxeig = 0;
+    for (magma_int_t i = 0; i < Nfound; i++) {
