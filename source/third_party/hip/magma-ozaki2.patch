+#include <stdlib.h>
+#include <string.h>
+
+#include "magma_internal.h"
+#include "magma_ozaki2.h"
+
+#define COMPLEX
+
+/***************************************************************************//**
+    Deterministic algorithm choice, shared by the workspace query and the
+    solve.  Controlled by the environment variable MAGMA_OZAKI2_ALGO:
+      - "auto" (or unset): with nev = (iu - il + 1) for range == MagmaRangeI,
+        else nev = n (MagmaRangeAll and MagmaRangeV are treated as full
+        since the eigenvalue count of a value range is data-dependent):
+        2-stage iff (uplo == MagmaLower && n >= 2048 &&
+                     (2*nev <= n || n <= 3072)),
+        else 1-stage.  [Measured on gfx1200: 2-stage wins for selected
+        ranges (nev at most n/2) and for moderate full problems (n <= 3072);
+        the 2-stage back-transformation makes 1-stage faster for large
+        full-spectrum problems.]
+      - "2stage" (or "2"): force 2-stage, silently demoted to 1-stage for
+        uplo == MagmaUpper (the 2-stage reduction magma_zhetrd_he2hb is
+        implemented for lower storage only).
+      - "1stage" (or "1"), or any other value: 1-stage.
+    All inputs are available identically at workspace-query time, so the
+    query and the solve always agree.
+*******************************************************************************/
+static magma_int_t
+magma_zheevdx_ozaki2_choose_2stage(
+    magma_range_t range, magma_uplo_t uplo, magma_int_t n,
+    magma_int_t il, magma_int_t iu )
+{
+    const char* algo = getenv( "MAGMA_OZAKI2_ALGO" );
+    magma_int_t two_stage;
+    if ( algo == NULL || algo[0] == '\0' || strcmp( algo, "auto" ) == 0 ) {
+        magma_int_t nev = (range == MagmaRangeI) ? (iu - il + 1) : n;
+        two_stage = (n >= 2048) && (2*nev <= n || n <= 3072);
+    }
+    else if ( strcmp( algo, "2stage" ) == 0 || strcmp( algo, "2" ) == 0 ) {
+        two_stage = 1;
+    }
+    else {
+        /* "1stage", "1", or unrecognized value */
+        two_stage = 0;
+    }
+    /* the 2-stage reduction supports lower storage only; NEVER pick it
+       for upper */
+    if ( uplo != MagmaLower ) {
+        two_stage = 0;
+    }
+    return two_stage;
+}
+
+/***************************************************************************//**
+    Purpose
+    -------
+    EXPERIMENTAL (AMD/HIP-first; part of the OpenMX Ozaki Scheme II
+    integration).
+
+    ZHEEVDX_OZAKI2 computes selected eigenvalues and, optionally,
+    eigenvectors of a complex Hermitian matrix A, exactly like
+    magma_zheevdx (1-stage) or magma_zheevdx_2stage (2-stage), but enables
+    Ozaki Scheme II (GEMMul8, INT8) routing of the level-3 BLAS calls
+    issued by the solver while it runs.  On non-HIP builds, or when the
+    routing gates reject a call, this is a plain delegation with native
+    accuracy and performance.
+
+    The algorithm (1-stage vs 2-stage) is selected deterministically from
+    the environment variable MAGMA_OZAKI2_ALGO in {auto, 1stage, 2stage},
+    default auto:  with nev = (iu - il + 1) for range == MagmaRangeI, else
+    nev = n (MagmaRangeAll and MagmaRangeV are treated as full),
+    2-stage iff (uplo == MagmaLower && n >= 2048 && (2*nev <= n || n <= 3072)).
+    The 2-stage algorithm is never used for uplo == MagmaUpper.  The
+    workspace query (lwork = -1, ...) and the solve use the SAME choice
+    (nev is known at query time from the same arguments), so query this
+    routine with the same environment and range arguments that will be
+    used for the solve.
+
+    Arguments
+    ---------
+    Identical to magma_zheevdx / magma_zheevdx_2stage (jobz, range, uplo,
+    n, A, lda, vl, vu, il, iu, m, w, work, lwork, rwork, lrwork, iwork,
+    liwork, info); see those routines for the full documentation.  Note
+    that the workspace requirements of the two algorithms differ.
+
+    @ingroup magma_heevdx
+*******************************************************************************/
+extern "C" magma_int_t
+magma_zheevdx_ozaki2(
+    magma_vec_t jobz, magma_range_t range, magma_uplo_t uplo,
+    magma_int_t n,
+    magmaDoubleComplex *A, magma_int_t lda,
+    double vl, double vu, magma_int_t il, magma_int_t iu,
+    magma_int_t *m, double *w,
+    magmaDoubleComplex *work, magma_int_t lwork,
+    #ifdef COMPLEX
+    double *rwork, magma_int_t lrwork,
+    #endif
+    magma_int_t *iwork, magma_int_t liwork,
+    magma_int_t *info)
+{
+    magma_int_t lquery;
+    #ifdef COMPLEX
+    lquery = (lwork == -1 || lrwork == -1 || liwork == -1);
+    #else
+    lquery = (lwork == -1 || liwork == -1);
+    #endif
+
+    magma_int_t use_2stage =
+        magma_zheevdx_ozaki2_choose_2stage( range, uplo, n, il, iu );
+
+    /* Argument validation is left to the delegate (same signature, same
+       error codes); nothing is dereferenced before delegation. */
+
+    #ifdef MAGMA_HAVE_HIP
+    if ( ! lquery ) {
+        magma_ozaki2_scope_begin();
+    }
+    #endif
+
+    if ( use_2stage ) {
+        magma_zheevdx_2stage( jobz, range, uplo, n, A, lda,
+                              vl, vu, il, iu, m, w,
+                              work, lwork,
+                              #ifdef COMPLEX
+                              rwork, lrwork,
+                              #endif
+                              iwork, liwork, info );
+    }
+    else {
+        magma_zheevdx( jobz, range, uplo, n, A, lda,
+                       vl, vu, il, iu, m, w,
+                       work, lwork,
+                       #ifdef COMPLEX
+                       rwork, lrwork,
+                       #endif
+                       iwork, liwork, info );
+    }
+
+    #ifdef MAGMA_HAVE_HIP
+    if ( ! lquery ) {
+        magma_ozaki2_scope_end();
+    }
+    #endif
+
+    return *info;
+} /* magma_zheevdx_ozaki2 */
