+extern "C" void
+magma_ozaki2_release_workspaces( void )
+{
+    std::lock_guard<std::mutex> lock( g_mutex );
+    int  cur      = 0;
+    bool have_cur = (hipGetDevice( &cur ) == hipSuccess);
+    for (auto& kv : g_entries) {
+        OzEntry& e = kv.second;
+        (void) hipSetDevice( e.device );
+        if (e.ws != NULL)
+            (void) hipFree( e.ws );
+        if (e.handle != NULL)
+            (void) hipblasDestroy( e.handle );
+    }
+    g_entries.clear();
+    if (have_cur)
+        (void) hipSetDevice( cur );
+}
