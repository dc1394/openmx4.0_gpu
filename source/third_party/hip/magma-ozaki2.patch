+extern "C" magma_int_t
+magma_ozaki2_try_dgemm(
+    magma_trans_t transA, magma_trans_t transB,
+    magma_int_t m, magma_int_t n, magma_int_t k,
+    double alpha,
+    const double *dA, magma_int_t ldda,
+    const double *dB, magma_int_t lddb,
+    double beta,
+    double       *dC, magma_int_t lddc,
+    magma_queue_t queue )
+{
+    if (! magma_ozaki2_active())
+        return 0;
+    const OzConfig& c = oz_config();
+    if (! oz_op_enabled( OZ_GEMM ))
+        return oz_reject_gate( OZ_GEMM, "op disabled", m, n, k );
+    hipblasOperation_t opA, opB;
+    if (! oz_map_trans( transA, true, &opA ) || ! oz_map_trans( transB, true, &opB ))
+        return oz_reject_gate( OZ_GEMM, "bad trans", m, n, k );
+    if (! oz_size_gate_ok( m, n, k, false, OZ_GEMM ))
+        return oz_reject_gate( OZ_GEMM, "size gate", m, n, k );
+
+    std::lock_guard<std::mutex> lock( g_mutex );
+    OzEntry* e = oz_get_entry( queue );
+    if (e == NULL)
+        return oz_reject_ws( OZ_GEMM, "handle", 0 );
+    size_t wsz = gemmul8::workSize<false, gemmul8::Backend::INT8, gemmul8::Func::gemm>(
+        (size_t) m, (size_t) n, (size_t) k, c.num_moduli );
+    if (wsz > e->cap)
+        wsz = e->cap;   // memory-saving mode blocks the GEMM to fit the cap
+    if (! oz_ensure_ws( e, wsz ))
+        return oz_reject_ws( OZ_GEMM, "workspace", wsz );
+
+    double h_alpha = alpha;  // host-side scalars (GEMMul8 requires both on
+    double h_beta  = beta;   // the same side; MAGMA passes them by value)
+    (void) gemmul8::gemm<double, gemmul8::Backend::INT8>(
+        e->handle, opA, opB,
+        (size_t) m, (size_t) n, (size_t) k,
+        &h_alpha, dA, (size_t) ldda,
+                  dB, (size_t) lddb,
+        &h_beta,  dC, (size_t) lddc,
+        c.num_moduli, c.fastmode, e->ws );
+    oz_routed( OZ_GEMM, m, n, k );
+    return 1;
+}
