+// -----------------------------------------------------------------------------
+// trmm: MAGMA semantics are IN-PLACE (dB := alpha*op(A)*dB), but GEMMul8's
+// trmm is OUT-OF-PLACE with separate input B / output C and no beta.
+// Route via a temporary C at the end of our workspace, then copy back into
+// dB with hipMemcpy2DAsync on the queue's stream (stream-ordered, no sync).
+// -----------------------------------------------------------------------------
+
+namespace {
+
+template <typename T>
+magma_int_t oz_try_trmm_impl(
+    magma_side_t side, magma_uplo_t uplo, magma_trans_t trans, magma_diag_t diag,
+    magma_int_t m, magma_int_t n,
+    T alpha,
+    const T *dA, magma_int_t ldda,
+    T       *dB, magma_int_t lddb,
+    magma_queue_t queue )
+{
+    constexpr bool is_cplx = ! std::is_same_v<T, double>;
+
+    if (! magma_ozaki2_active())
+        return 0;
+    const OzConfig& c = oz_config();
+    magma_int_t keff = (side == MagmaLeft) ? m : n;
+    if (! oz_op_enabled( OZ_TRMM ))
+        return oz_reject_gate( OZ_TRMM, "op disabled", m, n, keff );
+    hipblasSideMode_t  hside;
+    hipblasFillMode_t  huplo;
+    hipblasOperation_t htrans;
+    hipblasDiagType_t  hdiag;
+    if (! oz_map_side( side, &hside ) || ! oz_map_uplo( uplo, &huplo ) ||
+        ! oz_map_trans( trans, ! is_cplx, &htrans ) || ! oz_map_diag( diag, &hdiag ))
+        return oz_reject_gate( OZ_TRMM, "bad enums", m, n, keff );
+    if (! oz_size_gate_ok( m, n, keff, is_cplx, OZ_TRMM ))
+        return oz_reject_gate( OZ_TRMM, "size gate", m, n, keff );
+
+    std::lock_guard<std::mutex> lock( g_mutex );
+    OzEntry* e = oz_get_entry( queue );
+    if (e == NULL)
+        return oz_reject_ws( OZ_TRMM, "handle", 0 );
+    size_t wsz = gemmul8::workSize<is_cplx, gemmul8::Backend::INT8, gemmul8::Func::trmm>(
+        (size_t) m, (size_t) n, (size_t) keff, c.num_moduli );
+    size_t wsz_al  = oz_round_up( wsz );
+    size_t c_bytes = (size_t) m * (size_t) n * sizeof(T);
+    if (! oz_ensure_ws( e, wsz_al + c_bytes ))
+        return oz_reject_ws( OZ_TRMM, "workspace", wsz_al + c_bytes );
+
+    T* Ctmp = reinterpret_cast<T*>( (char*) e->ws + wsz_al );
+    T  h_alpha = alpha;
+    (void) gemmul8::trmm<T, gemmul8::Backend::INT8>(
+        e->handle, hside, huplo, htrans, hdiag,
+        (size_t) m, (size_t) n,
+        &h_alpha, dA, (size_t) ldda,
+                  dB, (size_t) lddb,   // input B (not modified by GEMMul8)
+        Ctmp, (size_t) m,              // out-of-place C
+        c.num_moduli, c.fastmode, e->ws );
+
+    hipStream_t stream = magma_queue_get_hip_stream( queue );
+    hipError_t  err = hipMemcpy2DAsync(
+        dB,   (size_t) lddb * sizeof(T),
+        Ctmp, (size_t) m    * sizeof(T),
+        (size_t) m * sizeof(T), (size_t) n,
+        hipMemcpyDeviceToDevice, stream );
+    if (err != hipSuccess) {
+        // dB is still the untouched input: let the native path redo the op
+        return oz_reject_ws( OZ_TRMM, "copy-back", c_bytes );
+    }
+    oz_routed( OZ_TRMM, m, n, keff );
+    return 1;
+}
+
