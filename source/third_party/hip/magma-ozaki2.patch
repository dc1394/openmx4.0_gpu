+} // anonymous namespace
+
+// =============================================================================
+// Public scope / options / housekeeping API
+// =============================================================================
+
+extern "C" void
+magma_ozaki2_opts_init( magma_ozaki2_opts_t* opts )
+{
+    if (opts == NULL)
+        return;
+    const OzConfig& c = oz_config();
+    opts->num_moduli = (magma_int_t) c.num_moduli;
+    opts->fastmode   = (magma_int_t)(c.fastmode ? 1 : 0);
+    opts->min_dim    = (magma_int_t) c.min_dim;
+    opts->verbose    = (magma_int_t) c.verbose;
+    opts->min_mnk    = (size_t) c.min_mnk;
+    int dev = 0;
+    if (hipGetDevice( &dev ) == hipSuccess)
+        opts->max_ws_bytes = oz_compute_cap( dev );
+    else
+        opts->max_ws_bytes = c.max_ws_mb << 20;
+}
+
+extern "C" void
+magma_ozaki2_scope_begin( void )
+{
+    g_depth.fetch_add( 1, std::memory_order_relaxed );
+}
+
+extern "C" void
+magma_ozaki2_scope_end( void )
+{
+    int prev = g_depth.fetch_sub( 1, std::memory_order_relaxed );
+    if (prev <= 0) {
+        // unbalanced scope_end; clamp back
+        g_depth.fetch_add( 1, std::memory_order_relaxed );
+    }
+}
+
+extern "C" magma_int_t
+magma_ozaki2_active( void )
+{
+    const OzConfig& c = oz_config();
+    if (c.global_on)
+        return 1;
+    return (g_depth.load( std::memory_order_relaxed ) > 0) ? 1 : 0;
+}
