# Periodic 1 x 1 x 2 diamond cell: B2C14.
# Derived from atoms 1..16 of work/large_example/B2C62_Band.dat;
# basis, pseudopotentials, occupations and SCF settings are retained.
#
#      File Name
#

System.CurrrentDirectory         ./    # default=./
System.Name                     B2C14_Band
level.of.stdout                   1    # default=1 (1-3)
level.of.fileout                  0    # default=1 (1-3)

#
# Definition of Atomic Species
#

