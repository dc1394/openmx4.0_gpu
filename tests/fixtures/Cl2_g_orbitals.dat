# Oblique molecule with all nine g components, for CPU/GPU force regression.
# Also usable with: openmx input.dat -forcetest2 0
System.CurrrentDirectory ./
System.Name Cl2_g
DATA.PATH ../../DFT_DATA19
level.of.stdout 1
level.of.fileout 1

Species.Number 1
<Definition.of.Atomic.Species
Cl Cl7.0-s2p2d1f1g1 Cl_PBE19
Definition.of.Atomic.Species>

Atoms.Number 2
Atoms.SpeciesAndCoordinates.Unit AU
<Atoms.SpeciesAndCoordinates
1 Cl 8.13 8.27 8.41 3.5 3.5
2 Cl 11.03 10.37 9.91 3.5 3.5
Atoms.SpeciesAndCoordinates>
Atoms.UnitVectors.Unit AU
<Atoms.UnitVectors
24.0 0.0 0.0
0.0 24.0 0.0
0.0 0.0 24.0
Atoms.UnitVectors>

scf.XcType GGA-PBE
scf.SpinPolarization off
scf.ElectronicTemperature 300.0
scf.energycutoff 250.0
scf.maxIter 100
scf.EigenvalueSolver cluster
scf.eigen.lib gpusolver
scf.Mixing.Type rmm-diis
scf.Init.Mixing.Weight 0.1
scf.Min.Mixing.Weight 0.001
scf.Max.Mixing.Weight 0.3
scf.Mixing.History 8
scf.Mixing.StartPulay 6
scf.criterion 1.0e-11
MD.Type Nomd
