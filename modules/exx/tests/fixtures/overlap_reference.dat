#
# A small triclinic cell with three species at general positions.  The run
# only serves to write the overlap matrix of the main program (HS.fileout);
# tools/exx_overlap_fixture.py makes overlap_reference.txt from this input and
# the .scfout file of the run.  DATA.PATH is relative to this directory.
#
System.CurrrentDirectory         ./
System.Name                      sich
level.of.stdout                   1
level.of.fileout                  0
DATA.PATH                        ../../../../DFT_DATA19
HS.fileout                       on

Species.Number       3
<Definition.of.Atomic.Species
 Si  Si7.0-s2p2d1f1   Si_PBE19
 C   C6.0-s2p2d1      C_PBE19
 H   H6.0-s2p1        H_PBE19
Definition.of.Atomic.Species>

Atoms.Number         3
Atoms.SpeciesAndCoordinates.Unit   AU
<Atoms.SpeciesAndCoordinates
 1  Si   0.30   0.20   0.10    2.0  2.0
 2  C    3.10   2.30   1.40    2.0  2.0
 3  H    4.60   3.30   2.60    0.5  0.5
Atoms.SpeciesAndCoordinates>
Atoms.UnitVectors.Unit             AU
<Atoms.UnitVectors
  7.5   0.0   0.0
  1.5   6.5   0.0
  0.8  -1.1   7.0
Atoms.UnitVectors>

scf.XcType                 GGA-PBE
scf.SpinPolarization        off
scf.ElectronicTemperature  300.0
scf.energycutoff           100.0
scf.maxIter                 1
scf.EigenvalueSolver        band
scf.Kgrid                  1 1 1
scf.Mixing.Type            simple
scf.criterion             1.0e-6

1DFFT.NumGridK              900
1DFFT.NumGridR              900
1DFFT.EnergyCutoff         3600.0

MD.Type                     nomd
